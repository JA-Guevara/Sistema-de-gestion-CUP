{% extends 'app_base.html.twig' %}

{% block title %}Asignar estudiantes a grupos{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="/assets/gestion/css/gestion.css?v=17">
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="/assets/gestion/js/gestion-filters.js?v=9" defer></script>
    <script src="/assets/gestion/js/asignacion-turno.js?v=1" defer></script>
{% endblock %}

{% block app_content %}
    <section class="gestion-head">
        <div>
            <p class="gestion-eyebrow">Asignaciones</p>
            <h1 class="app-content__title">Asignar estudiantes a grupos</h1>
        </div>
        <a href="{{ path('asignacion_index') }}" class="gestion-button">Volver</a>
    </section>

    {% include '@gestion/partials/_flash.html.twig' %}

    {% if gestion is null %}
        <section class="gestion-panel">
            <p>No hay una gestion CUP activa en este momento.</p>
        </section>
    {% else %}
        <section class="gestion-panel">
            <div class="gestion-panel__header">
                <div>
                    <h2>Seleccionar grupo &mdash; {{ gestion.nombre }}</h2>
                    <p class="gestion-panel__hint">Elige un turno para filtrar y un grupo. El estudiante quedara matriculado en todas las materias del grupo.</p>
                </div>
            </div>
            <form method="get" action="{{ path('asignacion_estudiantes') }}" class="gestion-form">
                <div class="gestion-grid gestion-grid--three">
                    <label>Turno (filtro)
                        <select data-turno-filter="estudiantes">
                            <option value="">Todos los turnos</option>
                            {% for turno in turnos %}
                                <option value="{{ turno.id }}">{{ turno.nombre|capitalize }}</option>
                            {% endfor %}
                            <option value="sin-turno">Sin turno</option>
                        </select>
                    </label>
                    <label>Grupo
                        <select name="grupo" required data-grupo-select="estudiantes">
                            <option value="">Seleccionar grupo</option>
                            {% for grupo in grupos %}
                                <option value="{{ grupo.id }}" data-turno="{{ grupo.turno ? grupo.turno.id : '' }}" {{ grupo.id == grupoSel ? 'selected' : '' }}>{{ grupo.codigo }} - {{ grupo.nombre }}{{ grupo.turno ? ' · ' ~ grupo.turno.nombre|capitalize : '' }}</option>
                            {% endfor %}
                        </select>
                    </label>
                    <div class="gestion-filters__field gestion-filters__field--clear">
                        <label aria-hidden="true">Ver</label>
                        <button class="gestion-button gestion-button--primary" type="submit">Ver grupo</button>
                    </div>
                </div>
            </form>
        </section>

        {% if grupoSel > 0 and detalle is not null %}
            {% set t = detalle.tarjeta %}
            <section class="gestion-dashboard">
                <div class="gestion-metric"><span class="gestion-metric__label">Turno</span><strong>{{ t and t.turno ? t.turno.nombre|capitalize : 'Sin turno' }}</strong></div>
                <div class="gestion-metric"><span class="gestion-metric__label">Aula</span><strong>{{ t and t.aulas is not empty ? t.aulas|join(', ') : '—' }}</strong></div>
                <div class="gestion-metric"><span class="gestion-metric__label">Horario</span><strong>{{ t and t.horaInicio and t.horaFin ? t.horaInicio|date('H:i') ~ ' - ' ~ t.horaFin|date('H:i') : 'Sin horario' }}</strong></div>
                <div class="gestion-metric"><span class="gestion-metric__label">Cupos disponibles</span><strong>{{ t ? t.disponibles : 0 }} de {{ detalle.grupo.cupo }}</strong></div>
            </section>

            <section class="gestion-panel">
                <div class="gestion-panel__header">
                    <div>
                        <h2>Estudiantes en el grupo {{ detalle.grupo.codigo }}</h2>
                        <p class="gestion-panel__hint">Inscritos asignados: <strong>{{ asignados|length }}</strong>.</p>
                    </div>
                </div>
                <div class="gestion-table-wrap">
                    <table class="gestion-table gestion-table--stack">
                        <thead>
                            <tr><th>CI</th><th>Estudiante</th><th class="gestion-table__actions-cell">Acciones</th></tr>
                        </thead>
                        <tbody>
                            {% for inscripcion in asignados %}
                                <tr>
                                    <td data-label="CI">{{ inscripcion.ci }}</td>
                                    <td data-label="Estudiante">{{ inscripcion.apellidos }} {{ inscripcion.nombres }}</td>
                                    <td class="gestion-table__actions" data-label="Acciones">
                                        <form method="post" action="{{ path('asignacion_estudiante_quitar') }}" data-confirm="Quitar a este estudiante del grupo?">
                                            <input type="hidden" name="_csrf_token" value="{{ csrf_token|default('') }}">
                                            <input type="hidden" name="grupo" value="{{ grupoSel }}">
                                            <input type="hidden" name="inscripcion" value="{{ inscripcion.id }}">
                                            <button class="gestion-link-button gestion-link-button--danger" type="submit" title="Quitar del grupo">
                                                <svg viewBox="0 0 24 24"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            {% else %}
                                <tr><td colspan="3">Ningun estudiante en este grupo todavia.</td></tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </section>

            <section class="gestion-panel">
                <div class="gestion-panel__header">
                    <div>
                        <h2>Agregar estudiantes al grupo</h2>
                        <p class="gestion-panel__hint">Marca uno o varios estudiantes y asignalos. Si estan en otro grupo, se moveran a este. Respeta el cupo disponible.</p>
                    </div>
                </div>

                <form class="gestion-filters" data-gestion-filters data-filter-target="disponibles">
                    <div class="gestion-filters__field">
                        <label>Buscar estudiante</label>
                        <input type="search" data-filter-field="texto" placeholder="CI, nombre o apellido">
                    </div>
                    <div class="gestion-filters__field gestion-filters__field--clear">
                        <label aria-hidden="true">Limpiar</label>
                        <button class="gestion-filters__clear" type="button" data-filter-clear aria-label="Limpiar filtros">
                            <svg viewBox="0 0 24 24"><path d="M3 6h18"/><path d="M8 6V4h8v2"/><path d="m6 10 1 10h10l1-10"/><path d="M10 14v3"/><path d="M14 14v3"/></svg>
                        </button>
                    </div>
                </form>

                <form method="post" action="{{ path('asignacion_estudiantes') }}">
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token|default('') }}">
                    <input type="hidden" name="grupo" value="{{ grupoSel }}">
                    <div class="gestion-table-wrap">
                        <table class="gestion-table gestion-table--stack" data-gestion-filter-table="disponibles">
                            <thead>
                                <tr><th></th><th>CI</th><th>Estudiante</th><th>Grupo actual</th></tr>
                            </thead>
                            <tbody>
                                {% for item in disponibles %}
                                    <tr data-filter-row data-filter-texto="{{ item.inscripcion.ci }} {{ item.inscripcion.apellidos }} {{ item.inscripcion.nombres }}">
                                        <td data-label="Seleccionar"><input type="checkbox" name="inscritos[]" value="{{ item.inscripcion.id }}"></td>
                                        <td data-label="CI">{{ item.inscripcion.ci }}</td>
                                        <td data-label="Estudiante">{{ item.inscripcion.apellidos }} {{ item.inscripcion.nombres }}</td>
                                        <td data-label="Grupo actual">{{ item.grupoActual ?? '-' }}</td>
                                    </tr>
                                {% endfor %}
                                <tr data-filter-empty {{ disponibles is empty ? '' : 'hidden' }}>
                                    <td colspan="4">
                                        {% if disponibles is empty %}No hay mas inscritos confirmados disponibles.{% else %}No se encontraron estudiantes con ese criterio.{% endif %}
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    {% if disponibles is not empty %}
                        <div class="gestion-actions">
                            <button class="gestion-button gestion-button--primary" type="submit">Asignar seleccionados</button>
                        </div>
                    {% endif %}
                </form>
            </section>
        {% elseif grupoSel > 0 %}
            <section class="gestion-panel">
                <p class="gestion-panel__hint">El grupo seleccionado no existe o no pertenece a la gestion activa.</p>
            </section>
        {% endif %}
    {% endif %}
{% endblock %}
