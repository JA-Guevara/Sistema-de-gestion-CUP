{% extends 'app_base.html.twig' %}

{% block title %}Asignaciones{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="/assets/gestion/css/gestion.css?v=17">
    <style>
        .adm-tabs{display:flex;flex-wrap:wrap;gap:8px;margin:0 0 16px}
        .adm-tab{display:inline-flex;align-items:center;gap:6px;padding:8px 14px;border-radius:999px;border:0;cursor:pointer;background:#f1f5f9;color:#64748b;font-weight:700;font-size:13px;font-family:inherit}
        .adm-tab:hover{background:#e2e8f0}
        .adm-tab.is-active{background:#1e3a8a;color:#fff}
        .adm-tab__dot{display:inline-flex;align-items:center;justify-content:center;min-width:20px;height:20px;padding:0 6px;border-radius:999px;background:rgba(148,163,184,.25);font-size:12px}
        .adm-tab.is-active .adm-tab__dot{background:rgba(255,255,255,.3)}
        .adm-slide{display:none}
        .adm-slide.is-active{display:block;animation:adm-fade .18s ease}
        @keyframes adm-fade{from{opacity:0;transform:translateY(4px)}to{opacity:1;transform:none}}
        .adm-nav{display:flex;align-items:center;justify-content:space-between;gap:12px;margin:6px 0 0}
        .adm-nav__pos{color:#64748b;font-weight:700;font-size:13px}
        .adm-nav button[disabled]{opacity:.4;cursor:not-allowed}
    </style>
{% endblock %}

{% block app_content %}
    <section class="gestion-head">
        <div>
            <p class="gestion-eyebrow">Administracion academica</p>
            <h1 class="app-content__title">Asignaciones</h1>
            <p class="gestion-help" style="margin:4px 0 0">Gestion activa: <strong>{{ gestion ? gestion.codigo : 'Sin gestion' }}</strong></p>
        </div>
        {% if user.hasPermission('usuarios.ver') or user.hasPermission('usuarios.gestionar') %}
            <div class="gestion-head__actions">
                <a href="{{ path('usuario_index') }}" class="gestion-button">Usuarios y roles</a>
            </div>
        {% endif %}
    </section>

    {% include '@gestion/partials/_flash.html.twig' %}

    <div class="adm-carousel" data-adm-carousel="asignacion">
        {% set slides = [{'key':'docentes','label':'Docentes'}, {'key':'estudiantes','label':'Estudiantes'}, {'key':'horarios','label':'Horarios'}] %}
        <div class="adm-tabs" role="tablist">
            {% for s in slides %}
                <button type="button" class="adm-tab {{ loop.first ? 'is-active' : '' }}" data-adm-go="{{ s.key }}">
                    <span class="adm-tab__dot">{{ loop.index }}</span> {{ s.label }}
                </button>
            {% endfor %}
        </div>

        {# ============ SLIDE: Docentes ============ #}
        <div class="adm-slide is-active" data-slide="docentes">
            <section class="gestion-panel">
                <div class="gestion-panel__header">
                    <div>
                        <h2>Asignacion de docentes</h2>
                        <p class="gestion-panel__hint">Asigna docentes a cada materia y grupo de la gestion activa (masiva o uno por uno).</p>
                    </div>
                    {% if user.hasPermission('asignaciones.gestionar') or user.hasPermission('notas.asignar') %}
                        <a href="{{ path('nota_asignaciones') }}" class="gestion-button gestion-button--primary">Asignar docentes</a>
                    {% endif %}
                </div>
                <div class="gestion-dashboard">
                    <section class="gestion-metric">
                        <span class="gestion-metric__label">Docentes con rol</span>
                        <strong>{{ stats.docentes }}</strong>
                    </section>
                    <section class="gestion-metric">
                        <span class="gestion-metric__label">Docentes asignados</span>
                        <strong>{{ stats.asignacionesDocente }}</strong>
                    </section>
                    <section class="gestion-metric">
                        <span class="gestion-metric__label">Materias activas</span>
                        <strong>{{ materias|length }}</strong>
                    </section>
                </div>
            </section>

            {% if asignacionesDocente is not empty %}
                <section class="gestion-panel">
                    <div class="gestion-panel__header">
                        <div>
                            <h2>Docentes asignados</h2>
                            <p class="gestion-panel__hint">Resumen de materia, grupo y docente para la gestion activa.</p>
                        </div>
                    </div>
                    <div class="gestion-table-wrap">
                        <table class="gestion-table gestion-table--stack">
                            <thead>
                                <tr>
                                    <th>Materia</th>
                                    <th>Grupo</th>
                                    <th>Docente</th>
                                    <th class="gestion-table__actions-cell">Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for asignacion in asignacionesDocente %}
                                    <tr>
                                        <td data-label="Materia">{{ asignacion.materia.codigo }} - {{ asignacion.materia.nombre }}</td>
                                        <td data-label="Grupo">{{ asignacion.grupo.codigo }}</td>
                                        <td data-label="Docente">{{ asignacion.docente.firstName }} {{ asignacion.docente.lastName }}</td>
                                        <td class="gestion-table__actions-cell" data-label="Acciones">
                                            <div class="gestion-table__actions">
                                                <a class="gestion-action-button gestion-action-button--view" href="{{ path('nota_planilla', {materiaId: asignacion.materia.id, grupoId: asignacion.grupo.id}) }}" aria-label="Ver planilla" title="Planilla">
                                                    <svg viewBox="0 0 24 24"><path d="M9 11h6"/><path d="M9 15h6"/><path d="M17 21H7a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h7l5 5v11a2 2 0 0 1-2 2Z"/><path d="M14 3v5h5"/></svg>
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </section>
            {% endif %}
        </div>

        {# ============ SLIDE: Estudiantes ============ #}
        <div class="adm-slide" data-slide="estudiantes">
            <section class="gestion-panel">
                <div class="gestion-panel__header">
                    <div>
                        <h2>Asignacion de estudiantes</h2>
                        <p class="gestion-panel__hint">Distribuye a los estudiantes confirmados en grupos por materia (masiva o uno por uno).</p>
                    </div>
                    {% if user.hasPermission('asignaciones.gestionar') or user.hasPermission('notas.asignar') %}
                        <a href="{{ path('nota_grupos') }}" class="gestion-button gestion-button--primary">Asignar estudiantes</a>
                    {% endif %}
                </div>
                <div class="gestion-dashboard">
                    <section class="gestion-metric">
                        <span class="gestion-metric__label">Inscritos confirmados</span>
                        <strong>{{ stats.inscritos }}</strong>
                    </section>
                    <section class="gestion-metric">
                        <span class="gestion-metric__label">Grupos</span>
                        <strong>{{ stats.grupos }}</strong>
                    </section>
                </div>
            </section>
        </div>

        {# ============ SLIDE: Horarios ============ #}
        <div class="adm-slide" data-slide="horarios">
            <section class="gestion-panel">
                <div class="gestion-panel__header">
                    <div>
                        <h2>Horarios</h2>
                        <p class="gestion-panel__hint">Gestiona los horarios de clases por materia, grupo y aula de la gestion activa.</p>
                    </div>
                    {% if user.hasPermission('academico.ver') or user.hasPermission('academico.gestionar') %}
                        <a href="{{ path('horario_index') }}" class="gestion-button gestion-button--primary">Gestionar horarios</a>
                    {% endif %}
                </div>
                <div class="gestion-dashboard">
                    <section class="gestion-metric">
                        <span class="gestion-metric__label">Materias activas</span>
                        <strong>{{ materias|length }}</strong>
                    </section>
                    <section class="gestion-metric">
                        <span class="gestion-metric__label">Grupos disponibles</span>
                        <strong>{{ grupos|length }}</strong>
                    </section>
                </div>
            </section>
        </div>

        <div class="adm-nav">
            <button type="button" class="gestion-button" data-adm-prev>&larr; Anterior</button>
            <span class="adm-nav__pos" data-adm-pos></span>
            <button type="button" class="gestion-button" data-adm-next>Siguiente &rarr;</button>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        (function () {
            var root = document.querySelector('[data-adm-carousel]');
            if (!root) { return; }
            var storeKey = 'adm-slide-' + (root.getAttribute('data-adm-carousel') || '');
            var slides = Array.prototype.slice.call(root.querySelectorAll('.adm-slide'));
            var tabs = Array.prototype.slice.call(root.querySelectorAll('.adm-tab'));
            var prev = root.querySelector('[data-adm-prev]');
            var next = root.querySelector('[data-adm-next]');
            var pos = root.querySelector('[data-adm-pos]');
            if (!slides.length) { return; }
            var current = 0;

            function indexOfKey(key) {
                for (var j = 0; j < slides.length; j++) {
                    if (slides[j].getAttribute('data-slide') === key) { return j; }
                }
                return -1;
            }

            function show(n) {
                current = Math.max(0, Math.min(n, slides.length - 1));
                slides.forEach(function (s, idx) { s.classList.toggle('is-active', idx === current); });
                tabs.forEach(function (t, idx) { t.classList.toggle('is-active', idx === current); });
                if (pos) { pos.textContent = (current + 1) + ' / ' + slides.length; }
                if (prev) { prev.disabled = current === 0; }
                if (next) { next.disabled = current === slides.length - 1; }
                try { sessionStorage.setItem(storeKey, slides[current].getAttribute('data-slide')); } catch (e) {}
            }

            tabs.forEach(function (t, idx) {
                t.addEventListener('click', function () { show(idx); root.scrollIntoView({ block: 'nearest' }); });
            });
            if (prev) { prev.addEventListener('click', function () { show(current - 1); root.scrollIntoView({ block: 'nearest' }); }); }
            if (next) { next.addEventListener('click', function () { show(current + 1); root.scrollIntoView({ block: 'nearest' }); }); }

            var saved = -1;
            try { saved = indexOfKey(sessionStorage.getItem(storeKey)); } catch (e) {}
            show(saved >= 0 ? saved : 0);
        }());
    </script>
{% endblock %}
