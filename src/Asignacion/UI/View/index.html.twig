{% extends 'app_base.html.twig' %}

{% block title %}Asignaciones{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="/assets/gestion/css/gestion.css?v=15">
{% endblock %}

{% block javascripts %}
    <script src="/assets/gestion/js/gestion-filters.js?v=9" defer></script>
    <script src="/assets/gestion/js/gestion-bulk-actions.js?v=9" defer></script>
{% endblock %}

{% block app_content %}
    <section class="gestion-head">
        <div>
            <p class="gestion-eyebrow">Administracion academica</p>
            <h1 class="app-content__title">Asignaciones</h1>
        </div>
        <div class="gestion-head__actions">
            {% if user.hasPermission('notas.asignar') %}
                <a href="{{ path('nota_asignaciones') }}" class="gestion-button">Docentes</a>
                <a href="{{ path('nota_grupos') }}" class="gestion-button gestion-button--primary">Estudiantes</a>
            {% endif %}
            {% if user.hasPermission('academico.ver') %}
                <a href="{{ path('horario_index') }}" class="gestion-button">Horarios</a>
            {% endif %}
        </div>
    </section>

    {% include '@gestion/partials/_flash.html.twig' %}

    <div class="gestion-dashboard">
        <section class="gestion-metric">
            <span class="gestion-metric__label">Gestion activa</span>
            <strong>{{ gestion ? gestion.codigo|replace({'CUP-2026-I': 'CUP 1-2026', 'CUP 2026-I': 'CUP 1-2026'}) : 'Sin gestion' }}</strong>
        </section>
        <section class="gestion-metric">
            <span class="gestion-metric__label">Inscritos</span>
            <strong>{{ stats.inscritos }}</strong>
        </section>
        <section class="gestion-metric">
            <span class="gestion-metric__label">Grupos</span>
            <strong>{{ stats.grupos }}</strong>
        </section>
        <section class="gestion-metric">
            <span class="gestion-metric__label">Docentes con rol</span>
            <strong>{{ stats.docentes }}</strong>
        </section>
    </div>

    {% if user.hasPermission('usuarios.ver') %}
        <section class="gestion-panel" data-bulk-root>
            <div class="gestion-panel__header">
                <div>
                    <h2>Asignacion masiva de roles</h2>
                    <p class="gestion-panel__hint">Selecciona usuarios y aplica el rol necesario. Los usuarios inactivos o que ya tienen el rol se omiten.</p>
                </div>
                <a href="{{ path('rol_index') }}" class="gestion-button">Roles y permisos</a>
            </div>

            <form class="gestion-filters" data-gestion-filters data-filter-target="asignacion-usuarios">
                <div class="gestion-filters__field">
                    <label>Buscar</label>
                    <input data-filter-field="texto" placeholder="Nombre, apellido o correo">
                </div>
                <div class="gestion-filters__field">
                    <label>Rol actual</label>
                    <select data-filter-field="rol">
                        <option value="">Todos</option>
                        {% for role in roles %}
                            <option value="{{ role.name }}">{{ role.name }}</option>
                        {% endfor %}
                        <option value="Sin rol">Sin rol</option>
                    </select>
                </div>
                <div class="gestion-filters__field">
                    <label>Estado</label>
                    <select data-filter-field="estado">
                        <option value="">Todos</option>
                        <option value="ACTIVO">Activo</option>
                        <option value="INACTIVO">Inactivo</option>
                    </select>
                </div>
                <div class="gestion-filters__field gestion-filters__field--clear">
                    <label aria-hidden="true">Limpiar</label>
                    <button class="gestion-filters__clear" type="button" data-filter-clear aria-label="Limpiar filtros">
                        <svg viewBox="0 0 24 24"><path d="M3 6h18"/><path d="M8 6V4h8v2"/><path d="m6 10 1 10h10l1-10"/><path d="M10 14v3"/><path d="M14 14v3"/></svg>
                    </button>
                </div>
            </form>

            <form id="asignacion-role-form" method="post" action="{{ path('asignacion_roles_bulk') }}" class="gestion-bulk-actions" data-bulk-actions hidden>
                <div class="gestion-bulk-actions__info">
                    <span class="gestion-bulk-actions__count"><strong data-bulk-count>0</strong> usuarios seleccionados</span>
                    <button type="button" class="gestion-bulk-actions__clear" data-bulk-clear>Deseleccionar</button>
                </div>
                <div class="gestion-bulk-actions__buttons">
                    <label class="gestion-bulk-actions__select">
                        Rol
                        <select name="roleId" required>
                            <option value="">Seleccionar rol</option>
                            {% for role in roles %}
                                <option value="{{ role.id }}">{{ role.name }}</option>
                            {% endfor %}
                        </select>
                    </label>
                    <button type="submit" class="gestion-button gestion-button--primary" data-bulk-submit disabled>
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
                        Asignar rol
                    </button>
                </div>
            </form>

            <div class="gestion-table-wrap">
                <table class="gestion-table gestion-table--stack" data-gestion-filter-table="asignacion-usuarios">
                    <thead>
                        <tr>
                            <th><input class="gestion-bulk-check" type="checkbox" data-bulk-check-all aria-label="Seleccionar usuarios visibles"></th>
                            <th>Usuario</th>
                            <th>Correo</th>
                            <th>Roles</th>
                            <th>Estado</th>
                            <th class="gestion-table__actions-cell">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for usuario in users %}
                            {% set estado = usuario.active ? 'ACTIVO' : 'INACTIVO' %}
                            <tr data-filter-row data-filter-texto="{{ usuario.firstName }} {{ usuario.lastName }} {{ usuario.email }}" data-filter-rol="{{ usuario.roleNames() }}" data-filter-estado="{{ estado }}">
                                <td data-label="Seleccion">
                                    <input class="gestion-bulk-check" type="checkbox" name="usuarios[]" value="{{ usuario.id }}" form="asignacion-role-form" data-bulk-item aria-label="Seleccionar {{ usuario.firstName }} {{ usuario.lastName }}">
                                </td>
                                <td data-label="Usuario">
                                    {{ usuario.firstName }} {{ usuario.lastName }}
                                    <span class="gestion-table__meta">#{{ usuario.id }}</span>
                                </td>
                                <td data-label="Correo">{{ usuario.email }}</td>
                                <td data-label="Roles">{{ usuario.roleNames() }}</td>
                                <td data-label="Estado">
                                    <span class="gestion-badge gestion-badge--{{ usuario.active ? 'activa' : 'inactiva' }}">{{ usuario.active ? 'Activo' : 'Inactivo' }}</span>
                                </td>
                                <td class="gestion-table__actions-cell" data-label="Acciones">
                                    <div class="gestion-table__actions">
                                        <a class="gestion-action-button gestion-action-button--view" href="{{ path('usuario_show', {id: usuario.id}) }}" aria-label="Ver usuario" title="Ver">
                                            <svg viewBox="0 0 24 24"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z"/><circle cx="12" cy="12" r="3"/></svg>
                                        </a>
                                        <a class="gestion-action-button gestion-action-button--edit" href="{{ path('usuario_edit', {id: usuario.id}) }}" aria-label="Editar usuario" title="Editar">
                                            <svg viewBox="0 0 24 24"><path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        {% endfor %}
                        <tr data-filter-empty {{ users ? 'hidden' : '' }}><td colspan="6">Todavia no hay usuarios registrados.</td></tr>
                    </tbody>
                </table>
            </div>
        </section>
    {% endif %}

    <section class="gestion-panel">
        <div class="gestion-panel__header">
            <div>
                <h2>Operacion academica</h2>
                <p class="gestion-panel__hint">Centraliza docentes, grupos de estudiantes y horarios de la gestion activa.</p>
            </div>
        </div>
        <div class="gestion-dashboard">
            <section class="gestion-metric">
                <span class="gestion-metric__label">Materias activas</span>
                <strong>{{ materias|length }}</strong>
            </section>
            <section class="gestion-metric">
                <span class="gestion-metric__label">Docentes asignados</span>
                <strong>{{ stats.asignacionesDocente }}</strong>
            </section>
            <section class="gestion-metric">
                <span class="gestion-metric__label">Grupos disponibles</span>
                <strong>{{ grupos|length }}</strong>
            </section>
        </div>
        <div class="gestion-actions">
            {% if user.hasPermission('notas.asignar') %}
                <a href="{{ path('nota_asignaciones') }}" class="gestion-button">Asignar docentes</a>
                <a href="{{ path('nota_grupos') }}" class="gestion-button gestion-button--primary">Asignar estudiantes</a>
            {% endif %}
            {% if user.hasPermission('academico.ver') %}
                <a href="{{ path('horario_index') }}" class="gestion-button">Gestionar horarios</a>
            {% endif %}
        </div>
    </section>

    {% if asignacionesDocente is not empty %}
        <section class="gestion-panel">
            <div class="gestion-panel__header">
                <div>
                    <h2>Docentes asignados</h2>
                    <p class="gestion-panel__hint">Resumen de materia, grupo y docente para la gestion activa.</p>
                </div>
            </div>
            <div class="gestion-table-wrap">
                <table class="gestion-table gestion-table--stack">
                    <thead>
                        <tr>
                            <th>Materia</th>
                            <th>Grupo</th>
                            <th>Docente</th>
                            <th class="gestion-table__actions-cell">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for asignacion in asignacionesDocente %}
                            <tr>
                                <td data-label="Materia">{{ asignacion.materia.codigo }} - {{ asignacion.materia.nombre }}</td>
                                <td data-label="Grupo">{{ asignacion.grupo.codigo }}</td>
                                <td data-label="Docente">{{ asignacion.docente.firstName }} {{ asignacion.docente.lastName }}</td>
                                <td class="gestion-table__actions-cell" data-label="Acciones">
                                    <div class="gestion-table__actions">
                                        <a class="gestion-action-button gestion-action-button--view" href="{{ path('nota_planilla', {materiaId: asignacion.materia.id, grupoId: asignacion.grupo.id}) }}" aria-label="Ver planilla" title="Planilla">
                                            <svg viewBox="0 0 24 24"><path d="M9 11h6"/><path d="M9 15h6"/><path d="M17 21H7a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h7l5 5v11a2 2 0 0 1-2 2Z"/><path d="M14 3v5h5"/></svg>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </section>
    {% endif %}
{% endblock %}
