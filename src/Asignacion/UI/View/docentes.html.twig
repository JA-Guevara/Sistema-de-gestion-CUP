{% extends 'app_base.html.twig' %}

{% block title %}Asignar docentes a grupos{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="/assets/gestion/css/gestion.css?v=17">
    <style>
        .asg-limit{display:inline-flex;align-items:center;gap:6px;padding:4px 10px;border-radius:999px;font-size:12px;font-weight:800}
        .asg-limit--ok{background:#ecfdf5;color:#047857}
        .asg-limit--full{background:#fef2f2;color:#b91c1c}
        /* el pill se alinea con el titulo aunque el hint envuelva en mobile */
        .gestion-panel__header .asg-limit{align-self:flex-start;margin-top:2px}
    </style>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="/assets/gestion/js/asignacion-turno.js?v=1" defer></script>
{% endblock %}

{% block app_content %}
    <section class="gestion-head">
        <div>
            <p class="gestion-eyebrow">Asignaciones</p>
            <h1 class="app-content__title">Asignar docentes a grupos</h1>
        </div>
        <a href="{{ path('asignacion_index') }}" class="gestion-button">Volver</a>
    </section>

    {% include '@gestion/partials/_flash.html.twig' %}

    {% if gestion is null %}
        <section class="gestion-panel">
            <p>No hay una gestion CUP activa en este momento.</p>
        </section>
    {% elseif docentes is empty %}
        <section class="gestion-panel">
            <p class="gestion-help">No hay usuarios con rol Docente. Asigna el rol "Docente" desde el modulo Usuarios.</p>
        </section>
    {% else %}
        <section class="gestion-panel">
            <div class="gestion-panel__header">
                <div>
                    <h2>Seleccionar docente</h2>
                    <p class="gestion-panel__hint">Un docente puede dictar en un maximo de {{ maxGrupos }} grupos distintos.</p>
                </div>
            </div>
            <form method="get" action="{{ path('asignacion_docentes') }}" class="gestion-form">
                <div class="gestion-grid">
                    <label>Docente
                        <select name="docente" required onchange="this.form.submit()">
                            <option value="">Seleccionar docente</option>
                            {% for docente in docentes %}
                                <option value="{{ docente.id }}" {{ docenteSel and docente.id == docenteSel.id ? 'selected' : '' }}>{{ docente.firstName }} {{ docente.lastName }}</option>
                            {% endfor %}
                        </select>
                    </label>
                    <div class="gestion-filters__field gestion-filters__field--clear">
                        <label aria-hidden="true">Ver</label>
                        <button class="gestion-button gestion-button--primary" type="submit">Ver</button>
                    </div>
                </div>
            </form>
        </section>

        {% if docenteSel is not null %}
            <section class="gestion-panel">
                <div class="gestion-panel__header">
                    <div>
                        <h2>{{ docenteSel.firstName }} {{ docenteSel.lastName }}</h2>
                        <p class="gestion-panel__hint">Grupos asignados: <strong>{{ gruposDelDocente }}</strong> de {{ maxGrupos }}.</p>
                    </div>
                    <span class="asg-limit {{ limiteAlcanzado ? 'asg-limit--full' : 'asg-limit--ok' }}">
                        {{ limiteAlcanzado ? 'Limite alcanzado' : (maxGrupos - gruposDelDocente) ~ ' grupo(s) disponible(s)' }}
                    </span>
                </div>
                <div class="gestion-table-wrap">
                    <table class="gestion-table gestion-table--stack">
                        <thead>
                            <tr><th>Materia</th><th>Grupo</th><th class="gestion-table__actions-cell">Acciones</th></tr>
                        </thead>
                        <tbody>
                            {% for a in asignacionesDocente %}
                                <tr>
                                    <td data-label="Materia">{{ a.materia.codigo }} - {{ a.materia.nombre }}</td>
                                    <td data-label="Grupo">{{ a.grupo.codigo }}{{ a.grupo.turno ? ' · ' ~ a.grupo.turno.nombre|capitalize : '' }}</td>
                                    <td class="gestion-table__actions" data-label="Acciones">
                                        <form method="post" action="{{ path('asignacion_docente_quitar', {id: a.id}) }}" data-confirm="Quitar esta asignacion?">
                                            <input type="hidden" name="_csrf_token" value="{{ csrf_token|default('') }}">
                                            <input type="hidden" name="docente" value="{{ docenteSel.id }}">
                                            <button class="gestion-link-button gestion-link-button--danger" type="submit" title="Quitar">
                                                <svg viewBox="0 0 24 24"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            {% else %}
                                <tr><td colspan="3">Este docente no tiene asignaciones todavia.</td></tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </section>

            {# ---------- Asignar grupo y sus materias ---------- #}
            <section class="gestion-panel">
                <div class="gestion-panel__header">
                    <div>
                        <h2>Asignar grupo y materias</h2>
                        <p class="gestion-panel__hint">Elige un grupo y marca las materias que <strong>{{ docenteSel.firstName }} {{ docenteSel.lastName }}</strong> dictara en ese grupo.</p>
                    </div>
                </div>
                {% if limiteAlcanzado %}
                    <p class="gestion-help">El docente alcanzo el limite de {{ maxGrupos }} grupos. Solo puede recibir mas materias en los grupos donde ya dicta.</p>
                {% endif %}
                <form method="post" action="{{ path('asignacion_docentes') }}" class="gestion-form">
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token|default('') }}">
                    <input type="hidden" name="docente" value="{{ docenteSel.id }}">
                    <div class="gestion-grid">
                        <label>Turno (filtro)
                            <select data-turno-filter="doc-grupo">
                                <option value="">Todos los turnos</option>
                                {% for turno in turnos %}
                                    <option value="{{ turno.id }}">{{ turno.nombre|capitalize }}</option>
                                {% endfor %}
                                <option value="sin-turno">Sin turno</option>
                            </select>
                        </label>
                        <label>Grupo
                            <select name="grupo" required data-grupo-select="doc-grupo">
                                <option value="">Seleccionar grupo</option>
                                {% for grupo in grupos %}
                                    <option value="{{ grupo.id }}" data-turno="{{ grupo.turno ? grupo.turno.id : '' }}" {{ grupo.id == grupoSel ? 'selected' : '' }}>{{ grupo.codigo }} - {{ grupo.nombre }}{{ grupo.turno ? ' · ' ~ grupo.turno.nombre|capitalize : '' }}</option>
                                {% endfor %}
                            </select>
                        </label>
                    </div>
                    <p class="gestion-panel__hint" style="margin:16px 0 8px">Materias que dictara en el grupo</p>
                    <div class="gestion-checks gestion-checks--cards">
                        {% for materia in materias %}
                            <label>
                                <input type="checkbox" name="materias[]" value="{{ materia.id }}">
                                <span>{{ materia.codigo }} - {{ materia.nombre }}</span>
                            </label>
                        {% else %}
                            <p class="gestion-panel__hint">No hay materias activas.</p>
                        {% endfor %}
                    </div>
                    <div class="gestion-actions">
                        <button class="gestion-button gestion-button--primary" type="submit">Asignar</button>
                    </div>
                </form>
            </section>
        {% endif %}
    {% endif %}
{% endblock %}
