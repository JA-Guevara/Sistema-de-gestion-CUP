{% extends 'app_base.html.twig' %}

{% block title %}Asignacion de docentes{% endblock %}

{% block stylesheets %}<link rel="stylesheet" href="/assets/gestion/css/gestion.css?v=15">{% endblock %}

{% block app_content %}
    <section class="gestion-head">
        <div>
            <p class="gestion-eyebrow">Asignaciones</p>
            <h1 class="app-content__title">Asignacion de docentes</h1>
        </div>
        <a href="{{ path('asignacion_index') }}" class="gestion-button">Volver</a>
    </section>

    {% include '@gestion/partials/_flash.html.twig' %}

    {% if gestion is null %}
        <section class="gestion-panel">
            <p class="gestion-panel__hint">No hay una gestion CUP activa. Activa una gestion para asignar docentes.</p>
        </section>
    {% else %}
        <section class="gestion-panel">
            <div class="gestion-panel__header">
                <div>
                    <h2>Nueva asignacion &mdash; {{ gestion.nombre }}</h2>
                    <p class="gestion-panel__hint">Asigna un docente a una materia y grupo de esta gestion.</p>
                </div>
            </div>
            <form method="post" class="gestion-form">
                <div class="gestion-grid gestion-grid--three">
                    <label>Materia
                        <select name="materia" required>
                            <option value="">Seleccionar materia</option>
                            {% for materia in materias %}
                                <option value="{{ materia.id }}">{{ materia.codigo }} - {{ materia.nombre }}</option>
                            {% endfor %}
                        </select>
                    </label>
                    <label>Grupo
                        <select name="grupo" required>
                            <option value="">Seleccionar grupo</option>
                            {% for grupo in grupos %}
                                <option value="{{ grupo.id }}">{{ grupo.codigo }} - {{ grupo.nombre }}</option>
                            {% endfor %}
                        </select>
                    </label>
                    <label>Docente
                        <select name="docente" required>
                            <option value="">Seleccionar docente</option>
                            {% for docente in docentes %}
                                <option value="{{ docente.id }}">{{ docente.firstName }} {{ docente.lastName }}</option>
                            {% endfor %}
                        </select>
                    </label>
                </div>
                {% if docentes is empty %}
                    <p class="gestion-help">No hay usuarios con rol Docente. Asigna el rol "Docente" desde el modulo Usuarios.</p>
                {% endif %}
                {% if grupos is empty %}
                    <p class="gestion-help">No hay grupos en esta gestion. Crea grupos en el modulo Grupos.</p>
                {% endif %}
                <div class="gestion-actions">
                    <button class="gestion-button gestion-button--primary" type="submit">Asignar docente</button>
                </div>
            </form>
        </section>

        <section class="gestion-panel">
            <div class="gestion-panel__header">
                <div>
                    <h2>Docentes asignados</h2>
                    <p class="gestion-panel__hint">Una materia y grupo tienen un docente por gestion.</p>
                </div>
            </div>
            <div class="gestion-table-wrap">
                <table class="gestion-table gestion-table--stack">
                    <thead>
                        <tr>
                            <th>Materia</th>
                            <th>Grupo</th>
                            <th>Docente</th>
                            <th class="gestion-table__actions-cell">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for asignacion in asignaciones %}
                            <tr>
                                <td class="gestion-col--text" data-label="Materia">{{ asignacion.materia.codigo }} - {{ asignacion.materia.nombre }}</td>
                                <td data-label="Grupo">{{ asignacion.grupo.codigo }}</td>
                                <td class="gestion-col--text" data-label="Docente">{{ asignacion.docente.firstName }} {{ asignacion.docente.lastName }}</td>
                                <td class="gestion-table__actions" data-label="Acciones">
                                    <a class="gestion-button" href="{{ path('nota_planilla', {materiaId: asignacion.materia.id, grupoId: asignacion.grupo.id}) }}">Cargar notas</a>
                                    <form method="post" action="{{ path('nota_asignacion_delete', {id: asignacion.id}) }}" onsubmit="return confirm('Quitar esta asignacion?');">
                                        <button class="gestion-link-button gestion-link-button--danger" type="submit" title="Quitar">
                                            <svg viewBox="0 0 24 24"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        {% else %}
                            <tr><td colspan="4">Todavia no hay docentes asignados.</td></tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </section>
    {% endif %}
{% endblock %}
