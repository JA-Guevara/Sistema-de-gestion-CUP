{% extends 'app_base.html.twig' %}

{% block title %}Asignar estudiantes a grupos{% endblock %}

{% block stylesheets %}<link rel="stylesheet" href="/assets/gestion/css/gestion.css?v=17">{% endblock %}

{% block javascripts %}<script src="/assets/gestion/js/gestion-filters.js?v=9" defer></script>{% endblock %}

{% block app_content %}
    <section class="gestion-head">
        <div>
            <p class="gestion-eyebrow">Asignaciones</p>
            <h1 class="app-content__title">Asignar estudiantes a grupos</h1>
        </div>
        <a href="{{ path('asignacion_index') }}" class="gestion-button">Volver</a>
    </section>

    {% include '@gestion/partials/_flash.html.twig' %}

    {% if gestion is null %}
        <section class="gestion-panel">
            <p>No hay una gestion CUP activa en este momento.</p>
        </section>
    {% else %}
        <section class="gestion-panel">
            <div class="gestion-panel__header">
                <div>
                    <h2>Asignacion masiva por materia</h2>
                    <p class="gestion-panel__hint">Reparte automaticamente los inscritos de la gestion activa entre los grupos seleccionados respetando cupos.</p>
                </div>
            </div>
            <form method="post" action="{{ path('nota_grupos_masivo') }}" class="gestion-form">
                <div class="gestion-grid gestion-grid--three">
                    <label>Materia
                        <select name="materia" required>
                            <option value="">Seleccionar materia</option>
                            {% for materia in materias %}
                                <option value="{{ materia.id }}" {{ materia.id == materiaSel ? 'selected' : '' }}>{{ materia.codigo }} - {{ materia.nombre }}</option>
                            {% endfor %}
                        </select>
                    </label>
                    <label>Turno preferido
                        <select name="turnoPreferencia">
                            <option value="">Todos los turnos</option>
                            <option value="MANANA">Manana</option>
                            <option value="TARDE">Tarde</option>
                            <option value="NOCHE">Noche</option>
                        </select>
                    </label>
                    <label class="gestion-career__check">
                        <input type="checkbox" name="reasignarExistentes" value="1">
                        Reasignar inscritos existentes
                    </label>
                </div>

                <div class="gestion-checks gestion-checks--cards">
                    {% for grupo in grupos %}
                        <label>
                            <input type="checkbox" name="grupos[]" value="{{ grupo.id }}">
                            <span>{{ grupo.codigo }} - {{ grupo.nombre }} <small>{{ grupo.cupo }} cupos</small></span>
                        </label>
                    {% else %}
                        <p class="gestion-panel__hint">No hay grupos creados para esta gestion.</p>
                    {% endfor %}
                </div>

                <div class="gestion-actions">
                    <button class="gestion-button gestion-button--primary" type="submit">Asignar automaticamente</button>
                </div>
            </form>
        </section>

        <section class="gestion-panel">
            <h2>Seleccionar materia y grupo &mdash; {{ gestion.nombre }}</h2>
            <form method="get" action="{{ path('nota_grupos') }}" class="gestion-form">
                <div class="gestion-grid">
                    <label>Materia
                        <select name="materia" required>
                            <option value="">Seleccionar materia</option>
                            {% for materia in materias %}
                                <option value="{{ materia.id }}" {{ materia.id == materiaSel ? 'selected' : '' }}>{{ materia.codigo }} - {{ materia.nombre }}</option>
                            {% endfor %}
                        </select>
                    </label>
                    <label>Grupo
                        <select name="grupo" required>
                            <option value="">Seleccionar grupo</option>
                            {% for grupo in grupos %}
                                <option value="{{ grupo.id }}" {{ grupo.id == grupoSel ? 'selected' : '' }}>{{ grupo.codigo }} - {{ grupo.nombre }}</option>
                            {% endfor %}
                        </select>
                    </label>
                    <div class="gestion-filters__field gestion-filters__field--clear">
                        <label aria-hidden="true">Ver</label>
                        <button class="gestion-button gestion-button--primary" type="submit">Ver</button>
                    </div>
                </div>
            </form>
        </section>

        {% if materiaSel > 0 and grupoSel > 0 %}
            <section class="gestion-panel">
                <div class="gestion-panel__header">
                    <div>
                        <h2>Estudiantes en el grupo</h2>
                        <p class="gestion-panel__hint">Inscritos asignados a este grupo en esta materia: <strong>{{ asignados|length }}</strong>.</p>
                    </div>
                </div>
                <div class="gestion-table-wrap">
                    <table class="gestion-table gestion-table--stack">
                        <thead>
                            <tr><th>CI</th><th>Estudiante</th><th></th></tr>
                        </thead>
                        <tbody>
                            {% for asignacion in asignados %}
                                <tr>
                                    <td data-label="CI">{{ asignacion.inscripcion.ci }}</td>
                                    <td data-label="Estudiante">{{ asignacion.inscripcion.apellidos }} {{ asignacion.inscripcion.nombres }}</td>
                                    <td class="gestion-table__actions" data-label="Acciones">
                                        <form method="post" action="{{ path('nota_grupo_delete', {id: asignacion.id}) }}">
                                            <input type="hidden" name="materia" value="{{ materiaSel }}">
                                            <input type="hidden" name="grupo" value="{{ grupoSel }}">
                                            <button class="gestion-link-button gestion-link-button--danger" type="submit" title="Quitar del grupo">
                                                <svg viewBox="0 0 24 24"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            {% else %}
                                <tr><td colspan="3">Ningun estudiante en este grupo todavia.</td></tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </section>

            <section class="gestion-panel">
                <div class="gestion-panel__header">
                    <div>
                        <h2>Agregar estudiantes</h2>
                        <p class="gestion-panel__hint">Busca y marca los inscritos a asignar. Si ya estan en otro grupo de esta materia, se moveran a este.</p>
                    </div>
                </div>

                <form class="gestion-filters" data-gestion-filters data-filter-target="disponibles">
                    <div class="gestion-filters__field">
                        <label>Buscar estudiante</label>
                        <input type="search" data-filter-field="texto" placeholder="CI, nombre o apellido">
                    </div>
                    <div class="gestion-filters__field gestion-filters__field--clear">
                        <label aria-hidden="true">Limpiar</label>
                        <button class="gestion-filters__clear" type="button" data-filter-clear aria-label="Limpiar filtros">
                            <svg viewBox="0 0 24 24"><path d="M3 6h18"/><path d="M8 6V4h8v2"/><path d="m6 10 1 10h10l1-10"/><path d="M10 14v3"/><path d="M14 14v3"/></svg>
                        </button>
                    </div>
                </form>

                <form method="post" action="{{ path('nota_grupos') }}">
                    <input type="hidden" name="materia" value="{{ materiaSel }}">
                    <input type="hidden" name="grupo" value="{{ grupoSel }}">
                    <div class="gestion-table-wrap">
                        <table class="gestion-table gestion-table--stack" data-gestion-filter-table="disponibles">
                            <thead>
                                <tr><th></th><th>CI</th><th>Estudiante</th><th>Grupo actual</th></tr>
                            </thead>
                            <tbody>
                                {% for item in disponibles %}
                                    <tr data-filter-row data-filter-texto="{{ item.inscripcion.ci }} {{ item.inscripcion.apellidos }} {{ item.inscripcion.nombres }}">
                                        <td data-label="Seleccionar"><input type="checkbox" name="inscritos[]" value="{{ item.inscripcion.id }}"></td>
                                        <td data-label="CI">{{ item.inscripcion.ci }}</td>
                                        <td data-label="Estudiante">{{ item.inscripcion.apellidos }} {{ item.inscripcion.nombres }}</td>
                                        <td data-label="Grupo actual">{{ item.grupoActual ?? '-' }}</td>
                                    </tr>
                                {% endfor %}
                                <tr data-filter-empty {{ disponibles is empty ? '' : 'hidden' }}>
                                    <td colspan="4">
                                        {% if disponibles is empty %}No hay mas inscritos disponibles.{% else %}No se encontraron estudiantes con ese criterio.{% endif %}
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    {% if disponibles is not empty %}
                        <div class="gestion-actions">
                            <button class="gestion-button gestion-button--primary" type="submit">Asignar seleccionados</button>
                        </div>
                    {% endif %}
                </form>
            </section>
        {% endif %}
    {% endif %}
{% endblock %}
