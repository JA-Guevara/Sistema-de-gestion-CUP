{% extends 'app_base.html.twig' %}

{% block title %}Admision Final{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="/assets/gestion/css/gestion.css?v=17">
    <style>
        .adm-res{display:inline-flex;align-items:center;padding:3px 9px;border-radius:999px;font-size:11px;font-weight:800;white-space:nowrap}
        .adm-res--ADMITIDO_PRIMERA{background:#ecfdf5;color:#047857}
        .adm-res--ADMITIDO_SEGUNDA{background:#eff6ff;color:#1d4ed8}
        .adm-res--LISTA_ESPERA{background:#fffbeb;color:#b45309}
        .adm-res--REPROBADO{background:#fef2f2;color:#b91c1c}
        .adm-res--PENDIENTE{background:#f1f5f9;color:#475569}
        .adm-res--none{background:#f1f5f9;color:#94a3b8}
        /* Carrusel Estudiantes / Docentes */
        .adm-tabs{display:flex;flex-wrap:wrap;gap:8px;margin:0 0 16px}
        .adm-tab{display:inline-flex;align-items:center;gap:6px;padding:8px 16px;border-radius:999px;border:0;cursor:pointer;background:#f1f5f9;color:#64748b;font-weight:700;font-size:13px;font-family:inherit}
        .adm-tab:hover{background:#e2e8f0}
        .adm-tab.is-active{background:#1e3a8a;color:#fff}
        .adm-tab__dot{display:inline-flex;align-items:center;justify-content:center;min-width:20px;height:20px;padding:0 6px;border-radius:999px;background:rgba(148,163,184,.25);font-size:12px}
        .adm-tab.is-active .adm-tab__dot{background:rgba(255,255,255,.3)}
        .adm-slide{display:none}
        .adm-slide.is-active{display:block;animation:adm-fade .18s ease}
        @keyframes adm-fade{from{opacity:0;transform:translateY(4px)}to{opacity:1;transform:none}}
    </style>
{% endblock %}

{% block app_content %}
    <section class="gestion-head">
        <div>
            <p class="gestion-eyebrow">CUP FICCT · Admisiones</p>
            <h1 class="app-content__title">Admision Final</h1>
            <p class="gestion-help" style="margin:4px 0 0">Estudiantes: carrera por promedio y cupo. Docentes: decision de contratacion. Gestion activa: <strong>{{ gestion ? gestion.codigo|gestion_label : 'Sin gestion' }}</strong></p>
        </div>
    </section>

    {% include '@inscripcion/partials/_admision_tabs.html.twig' with {'active': 'admision'} %}

    {% include '@gestion/partials/_flash.html.twig' %}

    {% if gestion is null %}
        <section class="gestion-panel">
            <p class="gestion-panel__hint">No hay una gestion CUP activa. Activa una gestion para procesar la admision.</p>
        </section>
    {% else %}
        {% set puedeGestionar = user.hasPermission('inscripciones.gestionar') or user.hasPermission('inscripciones.validar') %}
        <div class="adm-carousel" data-adm-carousel="admision">
            <div class="adm-tabs" role="tablist">
                <button type="button" class="adm-tab is-active" data-adm-go="estudiantes"><span class="adm-tab__dot">1</span> Estudiantes</button>
                <button type="button" class="adm-tab" data-adm-go="docentes"><span class="adm-tab__dot">2</span> Docentes</button>
            </div>

            {# ===================== ESTUDIANTES ===================== #}
            <div class="adm-slide is-active" data-slide="estudiantes">
                <section class="gestion-panel">
                    <div class="gestion-panel__header">
                        <div>
                            <h2>Asignacion de carrera por notas finales</h2>
                            <p class="gestion-panel__hint">Ordena a los aprobados por promedio y adjudica cupo: 1ra opcion &rarr; 2da &rarr; lista de espera.</p>
                        </div>
                        {% if puedeGestionar %}
                            <form method="post" action="{{ path('admision_ejecutar') }}" data-confirm="Ejecutar la admision de estudiantes? Se recalculara la adjudicacion de cupos por promedio.">
                                <input type="hidden" name="_csrf_token" value="{{ csrf_token|default('') }}">
                                <button class="gestion-button gestion-button--primary" type="submit">Ejecutar admision</button>
                            </form>
                        {% endif %}
                    </div>
                    {% if data.cupos is empty %}
                        <p class="gestion-panel__hint">Esta gestion no tiene carreras con cupo configuradas.</p>
                    {% else %}
                        <div class="gestion-dashboard">
                            {% for c in data.cupos %}
                                <section class="gestion-metric">
                                    <span class="gestion-metric__label">{{ c.carrera }}</span>
                                    <strong>{{ c.admitidos }}/{{ c.cupo }}</strong>
                                    <span class="gestion-metric__label">{{ c.disponibles }} disponibles</span>
                                </section>
                            {% endfor %}
                        </div>
                    {% endif %}
                </section>

                <section class="gestion-panel">
                    <div class="gestion-panel__header">
                        <div>
                            <h2>Resultados ({{ data.totalEstudiantes }} estudiantes)</h2>
                            <p class="gestion-panel__hint">
                                {% if data.procesado %}Solo los aprobados reciben cupo, en orden de promedio.
                                {% else %}Aun no se ejecuto la admision de estudiantes en esta gestion.{% endif %}
                            </p>
                        </div>
                    </div>
                    <div class="gestion-table-wrap">
                        <table class="gestion-table gestion-table--stack">
                            <thead>
                                <tr>
                                    <th>CI</th><th>Estudiante</th>
                                    <th class="gestion-col--num">Promedio</th>
                                    <th class="gestion-col--center">Estado CUP</th>
                                    <th>1ra opcion</th><th>2da opcion</th>
                                    <th class="gestion-col--center">Resultado</th>
                                    <th>Carrera admitida</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for f in data.filas %}
                                    <tr>
                                        <td data-label="CI">{{ f.ci }}</td>
                                        <td data-label="Estudiante">{{ f.estudiante }}</td>
                                        <td class="gestion-col--num" data-label="Promedio">{{ f.promedio ?? '—' }}</td>
                                        <td class="gestion-col--center" data-label="Estado CUP">{{ f.estado|lower|capitalize }}</td>
                                        <td data-label="1ra opcion">{{ f.carreraPrimera ?? '—' }}</td>
                                        <td data-label="2da opcion">{{ f.carreraSegunda ?? '—' }}</td>
                                        <td class="gestion-col--center" data-label="Resultado">
                                            <span class="adm-res adm-res--{{ f.resultado ?? 'none' }}">{{ f.resultadoLabel }}</span>
                                        </td>
                                        <td data-label="Carrera admitida">{{ f.carreraAdmitida ?? '—' }}</td>
                                    </tr>
                                {% else %}
                                    <tr><td colspan="8">No hay estudiantes confirmados en esta gestion.</td></tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </section>
            </div>

            {# ===================== DOCENTES ===================== #}
            <div class="adm-slide" data-slide="docentes">
                <section class="gestion-panel">
                    <div class="gestion-panel__header">
                        <div>
                            <h2>Decision de contratacion de docentes ({{ data.docentes|length }})</h2>
                            <p class="gestion-panel__hint">La decision final aplica a docentes con documentos validados y entrevista agendada. Documentos y entrevista se gestionan en "Postulaciones".</p>
                        </div>
                    </div>
                    <div class="gestion-table-wrap">
                        <table class="gestion-table gestion-table--stack">
                            <thead>
                                <tr>
                                    <th>CI</th><th>Docente</th><th>Profesion / area</th>
                                    <th class="gestion-col--center">Fase</th>
                                    <th class="gestion-table__actions-cell">Decision</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for d in data.docentes %}
                                    <tr>
                                        <td data-label="CI">{{ d.insc.ci }}</td>
                                        <td data-label="Docente">{{ d.insc.apellidos }} {{ d.insc.nombres }}</td>
                                        <td data-label="Profesion / area">
                                            {{ d.insc.docenteProfesion ?? '—' }}
                                            {% if d.insc.docenteAreas %}<br><small style="color:#64748b">{{ d.insc.docenteAreas|join(', ')|lower|capitalize }}</small>{% endif %}
                                        </td>
                                        <td class="gestion-col--center" data-label="Fase">{{ d.fase }}</td>
                                        <td class="gestion-table__actions" data-label="Decision">
                                            {% if d.puedeResolver and puedeGestionar %}
                                                <form method="post" action="{{ path('admision_docente_resolver') }}" style="display:flex;flex-wrap:wrap;gap:6px;align-items:center" data-confirm="Registrar la decision de contratacion?">
                                                    <input type="hidden" name="_csrf_token" value="{{ csrf_token|default('') }}">
                                                    <input type="hidden" name="inscripcion" value="{{ d.insc.id }}">
                                                    <select name="resultado" required>
                                                        <option value="APROBADO">Contratar</option>
                                                        <option value="DESCARTADO">Descartar</option>
                                                    </select>
                                                    <input type="text" name="motivo" placeholder="Motivo (si descarta)" style="max-width:160px">
                                                    <button class="gestion-button gestion-button--primary" type="submit">Aplicar</button>
                                                </form>
                                            {% elseif d.insc.estado == 'VALIDADA' %}
                                                <span class="gestion-help">Agenda la entrevista en Postulaciones</span>
                                            {% else %}
                                                <span class="gestion-help">{{ d.fase }}</span>
                                            {% endif %}
                                        </td>
                                    </tr>
                                {% else %}
                                    <tr><td colspan="5">No hay postulaciones de docentes en esta gestion.</td></tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </section>
            </div>
        </div>
    {% endif %}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        (function () {
            var root = document.querySelector('[data-adm-carousel="admision"]');
            if (!root) { return; }
            var slides = Array.prototype.slice.call(root.querySelectorAll('.adm-slide'));
            var tabs = Array.prototype.slice.call(root.querySelectorAll('.adm-tab'));
            if (!slides.length) { return; }
            function show(key) {
                slides.forEach(function (s) { s.classList.toggle('is-active', s.getAttribute('data-slide') === key); });
                tabs.forEach(function (t) { t.classList.toggle('is-active', t.getAttribute('data-adm-go') === key); });
                try { sessionStorage.setItem('adm-admision-slide', key); } catch (e) {}
            }
            tabs.forEach(function (t) { t.addEventListener('click', function () { show(t.getAttribute('data-adm-go')); }); });
            var saved = null;
            try { saved = sessionStorage.getItem('adm-admision-slide'); } catch (e) {}
            if (saved) { show(saved); }
        }());
    </script>
{% endblock %}
