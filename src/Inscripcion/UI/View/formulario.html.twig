{% extends 'app_base.html.twig' %}

{% block title %}Pre-inscripcion CUP · {{ parent() }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="/assets/gestion/css/gestion.css?v=15">
{% endblock %}

{% block app_content %}
    <section class="gestion-head">
        <div>
            <p class="gestion-eyebrow">CUP FICCT</p>
            <h1 class="app-content__title">Pre-inscripcion CUP</h1>
        </div>
        <a class="gestion-button" href="{{ path('home') }}">Cancelar</a>
    </section>

    {% include '@gestion/partials/_flash.html.twig' %}

    {% if gestion is null or not inscripcionAbierta %}
        <section class="gestion-panel">
            <p class="gestion-panel__hint">Las inscripciones no estan abiertas en este momento.</p>
        </section>
    {% else %}
        <p class="gestion-panel__hint" style="margin:0 0 16px">
            Gestion: <strong>{{ gestion.codigo }}</strong>. Avanza por los pasos. Puedes <strong>guardar un borrador</strong> en cualquier momento.
        </p>

        <form method="post" class="gestion-form" data-gestion-wizard>
            <div class="gestion-wizard">
                <ol class="gestion-wizard__steps" aria-label="Pasos de la pre-inscripcion">
                    <li class="gestion-wizard__step" data-wizard-step><span>1</span> Tipo</li>
                    <li class="gestion-wizard__step" data-wizard-step><span>2</span> Datos personales</li>
                    <li class="gestion-wizard__step" data-wizard-step><span>3</span> Postulacion</li>
                    <li class="gestion-wizard__step" data-wizard-step><span>4</span> Otros</li>
                </ol>

                {# Paso 1: tipo y modalidad #}
                <section class="gestion-panel" data-wizard-panel>
                    <h2>Tipo de postulacion</h2>
                    <div class="gestion-grid">
                        <label>Postulo como
                            <select name="tipo" id="tipoPostulacion" required>
                                <option value="ESTUDIANTE" {{ app.request.query.get('tipo') != 'DOCENTE' ? 'selected' : '' }}>Estudiante (recibir clases del CUP)</option>
                                <option value="DOCENTE" {{ app.request.query.get('tipo') == 'DOCENTE' ? 'selected' : '' }}>Docente (dictar clases en el CUP)</option>
                            </select>
                        </label>
                        <label>Modalidad
                            <select name="modalidad">
                                <option value="PRESENCIAL">Presencial</option>
                                <option value="VIRTUAL">Virtual</option>
                            </select>
                        </label>
                    </div>
                </section>

                {# Paso 2: datos personales (comunes) #}
                <section class="gestion-panel" data-wizard-panel>
                    <h2>Datos personales</h2>
                    <div class="gestion-grid">
                        <label>CI <span style="color:#9b1c1c">*</span>
                            <input type="text" name="ci" maxlength="20" required>
                        </label>
                        <label>Fecha de nacimiento <span style="color:#9b1c1c">*</span>
                            <input type="date" name="fechaNacimiento" required>
                        </label>
                    </div>
                    <div class="gestion-grid">
                        <label>Nombres <span style="color:#9b1c1c">*</span>
                            <input type="text" name="nombres" maxlength="120" value="{{ user.firstName }}" required>
                        </label>
                        <label>Apellidos <span style="color:#9b1c1c">*</span>
                            <input type="text" name="apellidos" maxlength="120" value="{{ user.lastName }}" required>
                        </label>
                    </div>
                    <div class="gestion-grid">
                        <label>Sexo <span style="color:#9b1c1c">*</span>
                            <select name="sexo" required>
                                <option value="">Seleccionar</option>
                                <option value="M">Masculino</option>
                                <option value="F">Femenino</option>
                            </select>
                        </label>
                        <label>Telefono
                            <input type="tel" name="telefono" maxlength="20">
                        </label>
                    </div>
                    <div class="gestion-grid">
                        <label>Correo electronico <span style="color:#9b1c1c">*</span>
                            <input type="email" name="email" maxlength="180" value="{{ user.email }}" required>
                        </label>
                        <label>Ciudad
                            <input type="text" name="ciudad" maxlength="80">
                        </label>
                    </div>
                    <label>Direccion
                        <textarea name="direccion" rows="2"></textarea>
                    </label>
                </section>

                {# Paso 3: datos especificos segun tipo #}
                <section class="gestion-panel" data-wizard-panel>
                    <h2>Datos de la postulacion</h2>

                    <div data-seccion="estudiante">
                        <p class="gestion-panel__hint" style="padding:0 0 12px">Elige tu carrera; si se llenan los cupos de la primera, se considera la segunda opcion.</p>
                        <div class="gestion-grid">
                            <label>Carrera (1ra opcion)
                                <select name="carrera">
                                    <option value="">Seleccionar</option>
                                    {% for carrera in carreras %}
                                        <option value="{{ carrera.id }}">{{ carrera.nombre }} ({{ carrera.codigo }})</option>
                                    {% endfor %}
                                </select>
                            </label>
                            <label>Carrera (2da opcion)
                                <select name="carreraSegunda">
                                    <option value="">Sin segunda opcion</option>
                                    {% for carrera in carreras %}
                                        <option value="{{ carrera.id }}">{{ carrera.nombre }} ({{ carrera.codigo }})</option>
                                    {% endfor %}
                                </select>
                            </label>
                        </div>
                        <div class="gestion-grid">
                            <label>Colegio de procedencia
                                <input type="text" name="colegioProcedencia" maxlength="120">
                            </label>
                            <label>Turno de preferencia
                                <select name="turnoPreferencia">
                                    <option value="">Indiferente</option>
                                    <option value="MANANA">Manana</option>
                                    <option value="TARDE">Tarde</option>
                                    <option value="NOCHE">Noche</option>
                                </select>
                            </label>
                        </div>
                        <div class="gestion-checks">
                            <label><input type="checkbox" name="tituloBachiller" value="1"> <span>Poseo titulo de bachiller</span></label>
                        </div>
                    </div>

                    <div data-seccion="docente" hidden>
                        <p class="gestion-panel__hint" style="padding:0 0 12px">Requisitos: profesional en el area, con maestria y diplomado en educacion superior.</p>
                        <label>Profesion / area <span style="color:#9b1c1c">*</span>
                            <input type="text" name="docenteProfesion" maxlength="160" placeholder="Ej. Ing. de Sistemas - area de Computacion">
                        </label>
                        <div class="gestion-checks">
                            <label><input type="checkbox" name="docenteMaestria" value="1"> <span>Tengo maestria</span></label>
                            <label><input type="checkbox" name="docenteDiplomado" value="1"> <span>Tengo diplomado en educacion superior</span></label>
                        </div>
                        <label>Experiencia / observaciones
                            <textarea name="docenteExperiencia" rows="3" placeholder="Materias que puedes dictar, anios de experiencia..."></textarea>
                        </label>
                    </div>
                </section>

                {# Paso 4: otros #}
                <section class="gestion-panel" data-wizard-panel>
                    <h2>Otros</h2>
                    <label>Informacion adicional
                        <textarea name="otros" rows="3" placeholder="Cualquier otro dato relevante..."></textarea>
                    </label>
                    <p class="gestion-panel__hint" style="padding:12px 0 0">Al <strong>presentar</strong>, se te asignara una fecha de revision de documentos.</p>
                </section>

                <div class="gestion-wizard__footer">
                    <button type="button" class="gestion-button" data-wizard-prev hidden>Anterior</button>
                    <button type="button" class="gestion-button gestion-button--primary" data-wizard-next>Siguiente</button>
                    <button type="submit" class="gestion-button" name="accion" value="GUARDAR" formnovalidate>Guardar borrador</button>
                    <button type="submit" class="gestion-button gestion-button--primary" data-wizard-submit name="accion" value="PRESENTAR">Presentar pre-inscripcion</button>
                </div>
            </div>
        </form>
    {% endif %}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="/assets/gestion/js/gestion-wizard.js?v=4" defer></script>
    <script>
        (function () {
            var tipo = document.getElementById('tipoPostulacion');
            if (!tipo) { return; }
            var secciones = document.querySelectorAll('[data-seccion]');
            function toggle() {
                secciones.forEach(function (el) {
                    el.hidden = el.getAttribute('data-seccion') !== tipo.value.toLowerCase();
                });
            }
            tipo.addEventListener('change', toggle);
            toggle();
        }());
    </script>
{% endblock %}
