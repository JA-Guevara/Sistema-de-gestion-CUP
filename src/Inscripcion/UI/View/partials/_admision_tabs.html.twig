{# Pestañas del area Admisiones. Parametro: active = 'postulaciones' | 'admision' #}
<style>
    .adm-subtabs{display:flex;flex-wrap:wrap;gap:6px;margin:0 0 18px;border-bottom:1px solid #e2e8f0}
    .adm-subtab{display:inline-flex;align-items:center;gap:6px;padding:9px 16px;border-radius:10px 10px 0 0;text-decoration:none;font-weight:700;font-size:13px;color:#64748b;border:1px solid transparent;border-bottom:0;margin-bottom:-1px}
    .adm-subtab:hover{color:#1e3a8a;background:#f8fafc}
    .adm-subtab.is-active{color:#1e3a8a;background:#fff;border-color:#e2e8f0;border-bottom-color:#fff}
</style>
<nav class="adm-subtabs">
    <a class="adm-subtab {{ active == 'postulaciones' ? 'is-active' : '' }}" href="{{ path('inscripcion_admin') }}{{ gestion ? '?gestion=' ~ gestion.id : '' }}">Postulaciones</a>
    <a class="adm-subtab {{ active == 'admision' ? 'is-active' : '' }}" href="{{ path('admision_index') }}">Admision Final</a>
</nav>
