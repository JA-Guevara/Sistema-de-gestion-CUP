{% extends 'app_base.html.twig' %}

{% block title %}Postulante {{ inscripcion.ci }} · {{ parent() }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="/assets/gestion/css/gestion.css?v=17">
    <style>
        .adm-tabs{display:flex;flex-wrap:wrap;gap:8px;margin:0 0 16px}
        .adm-tab{display:inline-flex;align-items:center;gap:6px;padding:8px 14px;border-radius:999px;border:0;cursor:pointer;background:#f1f5f9;color:#64748b;font-weight:700;font-size:13px;font-family:inherit}
        .adm-tab:hover{background:#e2e8f0}
        .adm-tab.is-active{background:#1e3a8a;color:#fff}
        .adm-tab__dot{display:inline-flex;align-items:center;justify-content:center;min-width:20px;height:20px;padding:0 6px;border-radius:999px;background:rgba(148,163,184,.25);font-size:12px}
        .adm-tab.is-active .adm-tab__dot{background:rgba(255,255,255,.3)}
        .adm-slide{display:none}
        .adm-slide.is-active{display:block;animation:adm-fade .18s ease}
        @keyframes adm-fade{from{opacity:0;transform:translateY(4px)}to{opacity:1;transform:none}}
        .adm-nav{display:flex;align-items:center;justify-content:space-between;gap:12px;margin:6px 0 0}
        .adm-nav__pos{color:#64748b;font-weight:700;font-size:13px}
        .adm-nav button[disabled]{opacity:.4;cursor:not-allowed}
    </style>
{% endblock %}

{% set estadoClass = {'VALIDADA':'activa','CONFIRMADA':'activa','RECHAZADA':'inactiva','ANULADA':'inactiva','PRESENTADA':'borrador','BORRADOR':'borrador','PENDIENTE':'borrador','COMPLETADA':'activa'} %}
{% set estadoVerifLabel = {'PENDIENTE':'Pendiente','ENTREGADO':'Entregado','OBSERVADO':'Observado','FALTA':'No presento'} %}
{% set actaDisponible = inscripcion.estado in ['PRESENTADA', 'VALIDADA', 'CONFIRMADA'] %}
{% set anulacionDisponible = inscripcion.estado in ['PRESENTADA', 'VALIDADA', 'CONFIRMADA'] %}

{# Pestañas disponibles (segun el estado). El carrusel muestra una a la vez. #}
{% set slides = [{'key':'datos','label':'Datos'}] %}
{% if actaDisponible %}{% set slides = slides|merge([{'key':'acta','label':'Acta'}]) %}{% endif %}
{% set slides = slides|merge([{'key':'admision','label':'Admision'}]) %}
{% if anulacionDisponible %}{% set slides = slides|merge([{'key':'anulacion','label':'Anulacion'}]) %}{% endif %}
{% set slides = slides|merge([{'key':'documentos','label':'Documentos'}]) %}

{% block app_content %}
    <div class="gestion-head">
        <div>
            <p class="gestion-eyebrow">CUP FICCT · {{ inscripcion.tipo == 'DOCENTE' ? 'Docente' : 'Estudiante' }} · {{ inscripcion.modalidad|lower|capitalize }}</p>
            <h1 class="app-content__title">{{ inscripcion.nombres }} {{ inscripcion.apellidos }}</h1>
            <p class="gestion-help" style="margin:4px 0 0">CI: {{ inscripcion.ci }}</p>
        </div>
        <div class="gestion-head__actions">
            <span class="gestion-badge gestion-badge--{{ estadoClass[inscripcion.estado] ?? 'borrador' }}">{{ inscripcion.estado|lower|capitalize }}</span>
            <a class="gestion-button" href="{{ path('inscripcion_admin') }}">Volver</a>
        </div>
    </div>

    {% include '@gestion/partials/_flash.html.twig' %}

    <div class="adm-carousel" data-adm-carousel="{{ inscripcion.id }}">
        {# ---- Barra de pestañas (carrusel) ---- #}
        <div class="adm-tabs" role="tablist">
            {% for s in slides %}
                <button type="button" class="adm-tab {{ loop.first ? 'is-active' : '' }}" data-adm-go="{{ s.key }}">
                    <span class="adm-tab__dot">{{ loop.index }}</span> {{ s.label }}
                </button>
            {% endfor %}
        </div>

        {# ============ SLIDE: Datos ============ #}
        <div class="adm-slide is-active" data-slide="datos">
            <section class="gestion-panel">
                <div class="gestion-panel__header"><div><h2>Datos personales</h2></div></div>
                <div class="gestion-table-wrap">
                    <table class="gestion-table gestion-table--stack">
                        <tbody>
                            <tr><td class="gestion-col--text" data-label="CI">{{ inscripcion.ci }}</td><td class="gestion-col--text" data-label="Nombre">{{ inscripcion.nombres }} {{ inscripcion.apellidos }}</td></tr>
                            <tr><td class="gestion-col--text" data-label="Nacimiento">{{ inscripcion.fechaNacimiento|date('d/m/Y') }}</td><td class="gestion-col--text" data-label="Sexo">{{ inscripcion.sexo == 'M' ? 'Masculino' : 'Femenino' }}</td></tr>
                            <tr><td class="gestion-col--text" data-label="Email">{{ inscripcion.email }}</td><td class="gestion-col--text" data-label="Telefono">{{ inscripcion.telefono ?? '—' }}</td></tr>
                            <tr><td class="gestion-col--text" data-label="Ciudad">{{ inscripcion.ciudad ?? '—' }}</td><td class="gestion-col--text" data-label="Direccion">{{ inscripcion.direccion ?? '—' }}</td></tr>
                        </tbody>
                    </table>
                </div>
            </section>

            {% if inscripcion.tipo == 'DOCENTE' %}
                <section class="gestion-panel">
                    <div class="gestion-panel__header"><div><h2>Datos del docente</h2></div></div>
                    <div class="gestion-table-wrap">
                        <table class="gestion-table gestion-table--stack">
                            <tbody>
                                <tr><td class="gestion-col--text" data-label="Profesion / area">{{ inscripcion.docenteProfesion ?? '—' }}</td></tr>
                                <tr><td class="gestion-col--text" data-label="Areas que dicta">{{ inscripcion.docenteAreas ? inscripcion.docenteAreas|map(a => a|capitalize)|join(', ') : '—' }}</td></tr>
                                <tr><td class="gestion-col--text" data-label="Maestria">{{ inscripcion.docenteMaestria ? 'Si' : 'No' }}</td><td class="gestion-col--text" data-label="Diplomado">{{ inscripcion.docenteDiplomado ? 'Si' : 'No' }}</td></tr>
                                <tr><td class="gestion-col--text" data-label="Experiencia">{{ inscripcion.docenteExperiencia ?? '—' }}</td></tr>
                            </tbody>
                        </table>
                    </div>
                </section>
            {% else %}
                <section class="gestion-panel">
                    <div class="gestion-panel__header"><div><h2>Postulacion (estudiante)</h2></div></div>
                    <div class="gestion-table-wrap">
                        <table class="gestion-table gestion-table--stack">
                            <tbody>
                                <tr><td class="gestion-col--text" data-label="Carrera (1ra)">{{ inscripcion.carrera ? inscripcion.carrera.nombre ~ ' (' ~ inscripcion.carrera.codigo ~ ')' : '—' }}</td></tr>
                                <tr><td class="gestion-col--text" data-label="Carrera (2da)">{{ inscripcion.carreraSegunda ? inscripcion.carreraSegunda.nombre ~ ' (' ~ inscripcion.carreraSegunda.codigo ~ ')' : '—' }}</td></tr>
                                <tr><td class="gestion-col--text" data-label="Colegio">{{ inscripcion.colegioProcedencia ?? '—' }}</td><td class="gestion-col--text" data-label="Turno">{{ inscripcion.turnoPreferencia ?? 'Indiferente' }}</td></tr>
                                <tr><td class="gestion-col--text" data-label="Titulo bachiller">{{ inscripcion.tituloBachiller ? 'Si' : 'No' }}</td></tr>
                            </tbody>
                        </table>
                    </div>
                </section>
            {% endif %}
        </div>

        {# ============ SLIDE: Acta (control de recepcion) ============ #}
        {% if actaDisponible %}
            {% set actaResumen = inscripcion.resumenActa %}
            <div class="adm-slide" data-slide="acta">
                <section class="gestion-panel">
                    <div class="gestion-panel__header">
                        <div>
                            <h2>Control de recepcion de documentos</h2>
                            <p class="gestion-panel__hint">Acta de la cita de presentacion: marca cada requisito que el postulante trajo. Cuando TODOS los obligatorios esten "Entregado", se habilita "Aprobar postulacion".</p>
                        </div>
                        <span class="gestion-badge gestion-badge--{{ actaResumen.conformes == actaResumen.obligatorios ? 'activa' : (actaResumen.observados > 0 ? 'inactiva' : 'borrador') }}">{{ actaResumen.conformes }}/{{ actaResumen.obligatorios }} conformes</span>
                    </div>
                    {% if inscripcion.estado == 'PRESENTADA' %}
                        <form method="post" action="{{ path('inscripcion_admin_acta', {id: inscripcion.id}) }}">
                            <input type="hidden" name="_csrf_token" value="{{ csrf_token|default('') }}">
                            <div class="gestion-table-wrap">
                                <table class="gestion-table gestion-table--stack">
                                    <thead>
                                        <tr><th>Requisito</th><th class="gestion-col--center">Estado</th><th>Observacion</th></tr>
                                    </thead>
                                    <tbody>
                                        {% for req in requisitos %}
                                            {% set v = inscripcion.verificacionPorCodigo(req.codigo) %}
                                            {% set estadoActual = v ? v.estado : 'PENDIENTE' %}
                                            <tr>
                                                <td class="gestion-col--text" data-label="Requisito">
                                                    {{ req.etiqueta }}
                                                    <span class="gestion-table__meta">{{ req.obligatorio ? 'Obligatorio' : 'Opcional' }}</span>
                                                </td>
                                                <td class="gestion-col--center" data-label="Estado">
                                                    <select name="estado[{{ req.codigo }}]" style="min-height:36px;border:1px solid #cbd5e1;border-radius:6px;padding:6px 8px">
                                                        {% for code, label in estadoVerifLabel %}
                                                            <option value="{{ code }}" {{ estadoActual == code ? 'selected' : '' }}>{{ label }}</option>
                                                        {% endfor %}
                                                    </select>
                                                </td>
                                                <td data-label="Observacion">
                                                    <input type="text" name="observacion[{{ req.codigo }}]" value="{{ v ? v.observacion : '' }}" placeholder="Obs. (si esta observado)" style="min-height:36px;border:1px solid #cbd5e1;border-radius:6px;padding:6px 8px;width:100%">
                                                </td>
                                            </tr>
                                        {% endfor %}
                                    </tbody>
                                </table>
                            </div>
                            <div class="gestion-actions" style="padding:14px 18px 0">
                                <button class="gestion-button gestion-button--primary" type="submit">Guardar acta</button>
                            </div>
                        </form>
                    {% else %}
                        <div class="gestion-table-wrap">
                            <table class="gestion-table gestion-table--stack">
                                <thead>
                                    <tr><th>Requisito</th><th class="gestion-col--center">Estado</th><th>Observacion</th></tr>
                                </thead>
                                <tbody>
                                    {% for req in requisitos %}
                                        {% set v = inscripcion.verificacionPorCodigo(req.codigo) %}
                                        {% set estadoActual = v ? v.estado : 'PENDIENTE' %}
                                        {% set vClass = estadoActual == 'ENTREGADO' ? 'activa' : (estadoActual == 'OBSERVADO' ? 'inactiva' : 'borrador') %}
                                        <tr>
                                            <td class="gestion-col--text" data-label="Requisito">{{ req.etiqueta }}</td>
                                            <td class="gestion-col--center" data-label="Estado"><span class="gestion-badge gestion-badge--{{ vClass }}">{{ estadoVerifLabel[estadoActual] }}</span></td>
                                            <td class="gestion-col--text" data-label="Observacion">{{ v and v.observacion ? v.observacion : '—' }}</td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    {% endif %}
                </section>
            </div>
        {% endif %}

        {# ============ SLIDE: Admision ============ #}
        <div class="adm-slide" data-slide="admision">
            <section class="gestion-panel">
                <div class="gestion-panel__header">
                    <div>
                        <h2>Revision de admision</h2>
                        <p class="gestion-panel__hint">
                            Primero se revisan los documentos. Si es estudiante, la aprobacion habilita la pasarela de pago; si es docente, habilita la entrevista antes de aprobar o descartar.
                        </p>
                    </div>
                </div>
                <div style="padding:0 18px 18px;display:grid;gap:14px">
                    {% set acta = inscripcion.resumenActa %}
                    {% set todosOk = inscripcion.actaConforme %}
                    <p class="gestion-panel__hint" style="padding:0">
                        Estado: <span class="gestion-badge gestion-badge--{{ estadoClass[inscripcion.estado] ?? 'borrador' }}">{{ inscripcion.estado|lower|capitalize }}</span>
                        {% if inscripcion.fechaPresentacionDocs %} &middot; Revision agendada: <strong>{{ inscripcion.fechaPresentacionDocs|date('d/m/Y H:i') }}</strong>{% endif %}
                    </p>

                    {% if inscripcion.estado == 'RECHAZADA' %}
                        <p class="gestion-panel__hint" style="padding:0;color:#9b1c1c">Motivo del rechazo: {{ inscripcion.motivoRechazo ?? '—' }}</p>
                        {% if inscripcion.fechaPresentacionDocs or inscripcion.fechaEntrevista %}
                            <p class="gestion-panel__hint" style="padding:0">
                                {% if inscripcion.fechaPresentacionDocs %}Revision de documentos: <strong>{{ inscripcion.fechaPresentacionDocs|date('d/m/Y H:i') }}</strong>{% endif %}
                                {%- if inscripcion.fechaEntrevista %} &middot; Entrevista: <strong>{{ inscripcion.fechaEntrevista|date('d/m/Y H:i') }}</strong>{% endif %}
                            </p>
                        {% endif %}
                    {% elseif inscripcion.estado in ['PRESENTADA', 'VALIDADA'] %}
                        {% if inscripcion.estado == 'PRESENTADA' %}
                        <form method="post" action="{{ path('inscripcion_admin_agendar', {id: inscripcion.id}) }}" class="gestion-form">
                            <input type="hidden" name="_csrf_token" value="{{ csrf_token|default('') }}">
                            <div class="gestion-grid" style="grid-template-columns:1fr auto;align-items:end">
                                <label>Fecha y hora de revision de documentos
                                    <input type="datetime-local" name="fecha" required value="{{ inscripcion.fechaPresentacionDocs ? inscripcion.fechaPresentacionDocs|date('Y-m-d\\TH:i') : '' }}">
                                </label>
                                <button class="gestion-button" type="submit" style="align-self:end">{{ inscripcion.fechaPresentacionDocs ? 'Reprogramar' : 'Agendar' }}</button>
                            </div>
                        </form>
                        {% endif %}

                        {% if inscripcion.estado == 'PRESENTADA' %}
                            <p class="gestion-panel__hint" style="padding:0">
                                Acta de recepcion: <strong>{{ acta.conformes }}/{{ acta.obligatorios }}</strong> requisitos obligatorios conformes
                                {%- if acta.observados > 0 %} &middot; {{ acta.observados }} observado(s){% endif %}
                                {%- if acta.pendientes > 0 %} &middot; {{ acta.pendientes }} pendiente(s){% endif %}.
                            </p>
                        {% endif %}

                        <div class="gestion-actions" style="margin-top:0">
                            {% if inscripcion.estado == 'PRESENTADA' %}
                                {% if todosOk %}
                                    <form method="post" action="{{ path('inscripcion_admin_validar', {id: inscripcion.id}) }}" data-confirm="Aprobar la postulacion? Se habilitara el {{ inscripcion.tipo == 'DOCENTE' ? 'proceso de entrevista' : 'pago (billetera)' }} del postulante.">
                                        <input type="hidden" name="_csrf_token" value="{{ csrf_token|default('') }}">
                                        <button class="gestion-button gestion-button--primary" type="submit">
                                            {{ inscripcion.tipo == 'DOCENTE' ? 'Aprobar documentos y habilitar entrevista' : 'Aprobar documentos y habilitar pago' }}
                                        </button>
                                    </form>
                                {% else %}
                                    <button class="gestion-button" type="button" disabled title="Completa el acta de recepcion">Aprobar postulacion</button>
                                    <span class="gestion-panel__hint" style="padding:0">Marca como "Entregado" todos los requisitos obligatorios del acta de recepcion (pestaña Acta) para poder aprobar y continuar con {{ inscripcion.tipo == 'DOCENTE' ? 'la entrevista' : 'el pago' }}.</span>
                                {% endif %}
                            {% endif %}
                            <form method="post" action="{{ path('inscripcion_admin_rechazar', {id: inscripcion.id}) }}" data-confirm="Descartar esta postulacion?" style="display:flex;gap:8px;align-items:center">
                                <input type="hidden" name="_csrf_token" value="{{ csrf_token|default('') }}">
                                <input type="text" name="motivo" placeholder="Motivo (opcional)" style="min-height:40px;border:1px solid #cbd5e1;border-radius:6px;padding:8px 10px">
                                <button class="gestion-button gestion-button--danger" type="submit">Descartar</button>
                            </form>
                        </div>
                        {% if inscripcion.estado == 'VALIDADA' %}
                            <p class="gestion-panel__hint" style="padding:0;color:#166534">
                                &#10003; Documentacion aprobada.
                                {% if inscripcion.tipo == 'DOCENTE' %}
                                    Ahora agenda la entrevista. Despues de la entrevista registra si fue aprobado o descartado.
                                {% else %}
                                    Se habilito la <strong>pasarela de pago</strong> para el estudiante. La confirmacion normal se realiza cuando el pago queda registrado.
                                {% endif %}
                            </p>

                            {% if inscripcion.tipo == 'DOCENTE' %}
                                <form method="post" action="{{ path('inscripcion_admin_entrevista', {id: inscripcion.id}) }}" class="gestion-form">
                                    <input type="hidden" name="_csrf_token" value="{{ csrf_token|default('') }}">
                                    <div class="gestion-grid" style="grid-template-columns:1fr auto;align-items:end">
                                        <label>Fecha y hora de entrevista
                                            <input type="datetime-local" name="fecha" required value="{{ inscripcion.fechaEntrevista ? inscripcion.fechaEntrevista|date('Y-m-d\\TH:i') : '' }}">
                                        </label>
                                        <button class="gestion-button" type="submit" style="align-self:end">{{ inscripcion.fechaEntrevista ? 'Reprogramar entrevista' : 'Agendar entrevista' }}</button>
                                    </div>
                                </form>
                                {% if inscripcion.fechaEntrevista %}
                                    <p class="gestion-panel__hint" style="padding:0">Entrevista agendada: <strong>{{ inscripcion.fechaEntrevista|date('d/m/Y H:i') }}</strong>.</p>
                                    <form method="post" action="{{ path('inscripcion_admin_resolver', {id: inscripcion.id}) }}" class="gestion-form" data-confirm="Guardar la respuesta final de esta postulacion?">
                                        <input type="hidden" name="_csrf_token" value="{{ csrf_token|default('') }}">
                                        <div class="gestion-grid" style="grid-template-columns:1fr 1fr auto;align-items:end">
                                            <label>Respuesta de entrevista
                                                <select name="resultado" required>
                                                    <option value="">Selecciona una respuesta</option>
                                                    <option value="APROBADO">Aprobado / contratar docente</option>
                                                    <option value="DESCARTADO">Descartado</option>
                                                </select>
                                            </label>
                                            <label>Motivo u observacion
                                                <input type="text" name="motivo" placeholder="Opcional si aprueba; recomendado si descarta">
                                            </label>
                                            <button class="gestion-button gestion-button--primary" type="submit">Guardar respuesta</button>
                                        </div>
                                    </form>
                                {% else %}
                                    <p class="gestion-panel__hint" style="padding:0;color:#92400e">Pendiente: agenda la entrevista antes de aprobar o descartar al docente.</p>
                                {% endif %}
                            {% else %}
                                <div class="gestion-actions" style="margin-top:0">
                                    <form method="post" action="{{ path('inscripcion_admin_confirmar', {id: inscripcion.id}) }}" data-confirm="Confirmar manualmente la inscripcion? Usa esta opcion solo si el pago fue recibido fuera de la pasarela.">
                                        <input type="hidden" name="_csrf_token" value="{{ csrf_token|default('') }}">
                                        <button class="gestion-button gestion-button--primary" type="submit">Registrar pago presencial y confirmar</button>
                                    </form>
                                </div>
                            {% endif %}
                        {% endif %}
                    {% elseif inscripcion.estado == 'CONFIRMADA' %}
                        <p class="gestion-panel__hint" style="padding:0;color:#166534">Postulacion aprobada y confirmada. Ya puede entrar a las asignaciones.</p>
                        {% if inscripcion.fechaPresentacionDocs or inscripcion.fechaEntrevista %}
                            <p class="gestion-panel__hint" style="padding:0">
                                {% if inscripcion.fechaPresentacionDocs %}Revision de documentos: <strong>{{ inscripcion.fechaPresentacionDocs|date('d/m/Y H:i') }}</strong>{% endif %}
                                {%- if inscripcion.fechaEntrevista %} &middot; Entrevista: <strong>{{ inscripcion.fechaEntrevista|date('d/m/Y H:i') }}</strong>{% endif %}
                            </p>
                        {% endif %}
                    {% elseif inscripcion.estado == 'ANULADA' %}
                        <p class="gestion-panel__hint" style="padding:0;color:#9b1c1c">Postulacion anulada.</p>
                    {% else %}
                        <p class="gestion-panel__hint" style="padding:0">El postulante aun no ha presentado su pre-inscripcion (borrador).</p>
                    {% endif %}
                </div>
            </section>
        </div>

        {# ============ SLIDE: Anulacion ============ #}
        {% if anulacionDisponible %}
            <div class="adm-slide" data-slide="anulacion">
                <section class="gestion-panel">
                    <div class="gestion-panel__header">
                        <div>
                            <h2>Anulacion</h2>
                            <p class="gestion-panel__hint">{{ inscripcion.anulacionSolicitada ? 'El postulante solicito anular esta postulacion.' : 'Anula la postulacion si corresponde (accion administrativa).' }}</p>
                        </div>
                    </div>
                    <div style="padding:0 18px 18px;display:grid;gap:12px">
                        {% if inscripcion.anulacionSolicitada %}
                            <p class="gestion-panel__hint" style="padding:0;color:#9b1c1c">Solicitud de anulacion del postulante{% if inscripcion.motivoAnulacion %} &mdash; motivo: {{ inscripcion.motivoAnulacion }}{% endif %}.</p>
                        {% endif %}
                        <div class="gestion-actions" style="margin-top:0">
                            <form method="post" action="{{ path('inscripcion_admin_anular', {id: inscripcion.id}) }}" data-confirm="Anular la postulacion? Si estaba confirmada se quitara el rol al usuario.">
                                <input type="hidden" name="_csrf_token" value="{{ csrf_token|default('') }}">
                                <button class="gestion-button gestion-button--danger" type="submit">{{ inscripcion.anulacionSolicitada ? 'Anular (aprobar solicitud)' : 'Anular postulacion' }}</button>
                            </form>
                            {% if inscripcion.anulacionSolicitada %}
                                <form method="post" action="{{ path('inscripcion_admin_anulacion_rechazar', {id: inscripcion.id}) }}" data-confirm="Descartar la solicitud de anulacion?">
                                    <input type="hidden" name="_csrf_token" value="{{ csrf_token|default('') }}">
                                    <button class="gestion-button" type="submit">Rechazar solicitud</button>
                                </form>
                            {% endif %}
                        </div>
                    </div>
                </section>
            </div>
        {% endif %}

        {# ============ SLIDE: Documentos digitales ============ #}
        <div class="adm-slide" data-slide="documentos">
            <section class="gestion-panel">
                {% set resumenDocs = inscripcion.resumenDocumentos %}
                <div class="gestion-panel__header">
                    <div>
                        <h2>Documentos digitales (evidencia opcional)</h2>
                        <p class="gestion-panel__hint">Opcional: sube copias digitales como respaldo del expediente. El gate de aprobacion es el acta de recepcion presencial (pestaña Acta), no estos archivos.</p>
                    </div>
                    {% if resumenDocs.total > 0 %}
                        <span class="gestion-badge gestion-badge--{{ resumenDocs.aprobados == resumenDocs.total ? 'activa' : (resumenDocs.observados > 0 ? 'inactiva' : 'borrador') }}">{{ resumenDocs.aprobados }}/{{ resumenDocs.total }} aprobados</span>
                    {% endif %}
                </div>
                {% if inscripcion.documentos is defined and inscripcion.documentos|length > 0 %}
                    <div class="gestion-table-wrap">
                        <table class="gestion-table gestion-table--stack">
                            <thead>
                                <tr><th>Documento</th><th class="gestion-col--center">Estado</th><th>Revisar</th><th class="gestion-table__actions-cell">Quitar</th></tr>
                            </thead>
                            <tbody>
                                {% for doc in inscripcion.documentos %}
                                    {% set docClass = doc.estado == 'APROBADO' ? 'activa' : (doc.estado == 'OBSERVADO' ? 'inactiva' : 'borrador') %}
                                    <tr>
                                        <td class="gestion-col--text" data-label="Documento">
                                            <a href="/{{ doc.archivoRuta }}" target="_blank">{{ doc.nombre }}</a>
                                            <span class="gestion-table__meta">{{ doc.createdAt|date('d/m/Y') }}{% if doc.observacion %} · Obs: {{ doc.observacion }}{% endif %}</span>
                                        </td>
                                        <td class="gestion-col--center" data-label="Estado"><span class="gestion-badge gestion-badge--{{ docClass }}">{{ doc.estado|lower|capitalize }}</span></td>
                                        <td data-label="Revisar">
                                            <form method="post" action="{{ path('inscripcion_admin_documento_revisar', {documentoId: doc.id}) }}" style="display:flex;gap:6px;flex-wrap:wrap;align-items:center">
                                                <input type="hidden" name="_csrf_token" value="{{ csrf_token|default('') }}">
                                                <input type="hidden" name="inscripcionId" value="{{ inscripcion.id }}">
                                                <select name="estado" style="min-height:36px;border:1px solid #cbd5e1;border-radius:6px;padding:6px 8px">
                                                    <option value="APROBADO" {{ doc.estado == 'APROBADO' ? 'selected' : '' }}>Aprobado</option>
                                                    <option value="OBSERVADO" {{ doc.estado == 'OBSERVADO' ? 'selected' : '' }}>Observado</option>
                                                </select>
                                                <input type="text" name="observacion" value="{{ doc.observacion }}" placeholder="Observacion (si esta mal)" style="min-height:36px;border:1px solid #cbd5e1;border-radius:6px;padding:6px 8px">
                                                <button class="gestion-button" type="submit">Guardar</button>
                                            </form>
                                        </td>
                                        <td class="gestion-table__actions" data-label="Quitar">
                                            <form method="post" action="{{ path('inscripcion_documento_eliminar', {documentoId: doc.id}) }}" data-confirm="Eliminar este documento?">
                                                <input type="hidden" name="_csrf_token" value="{{ csrf_token|default('') }}">
                                                <button class="gestion-action-button gestion-action-button--danger" type="submit" title="Eliminar">
                                                    <svg viewBox="0 0 24 24"><polyline points="3 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                {% else %}
                    <p class="gestion-panel__hint">No se han subido documentos.</p>
                {% endif %}

                <form method="post" action="{{ path('inscripcion_documento_subir', {id: inscripcion.id}) }}" enctype="multipart/form-data" class="gestion-form">
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token|default('') }}">
                    <div class="gestion-grid" style="grid-template-columns:1fr 1fr auto;align-items:end">
                        <label>Nombre del documento
                            <input type="text" name="nombreDocumento" placeholder="Ej: Titulo bachiller" required>
                        </label>
                        <label>Archivo (PDF, PNG, JPG, DOC)
                            <input type="file" name="archivo" required accept=".pdf,.png,.jpg,.jpeg,.doc,.docx">
                        </label>
                        <button class="gestion-button gestion-button--primary" type="submit">Subir</button>
                    </div>
                </form>
            </section>
        </div>

        {# ---- Navegacion del carrusel ---- #}
        <div class="adm-nav">
            <button type="button" class="gestion-button" data-adm-prev>&larr; Anterior</button>
            <span class="adm-nav__pos" data-adm-pos></span>
            <button type="button" class="gestion-button" data-adm-next>Siguiente &rarr;</button>
        </div>
    </div>

    <div class="gestion-page-actions">
        <form method="post" action="{{ path('inscripcion_delete', {id: inscripcion.id}) }}" data-confirm="Eliminar permanentemente esta postulacion?">
            <input type="hidden" name="_csrf_token" value="{{ csrf_token|default('') }}">
            <button class="gestion-button gestion-button--danger" type="submit">Eliminar postulacion</button>
        </form>
        <a class="gestion-button" href="{{ path('inscripcion_admin') }}">Volver al listado</a>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        (function () {
            var root = document.querySelector('[data-adm-carousel]');
            if (!root) { return; }
            var storeKey = 'adm-slide-' + (root.getAttribute('data-adm-carousel') || '');
            var slides = Array.prototype.slice.call(root.querySelectorAll('.adm-slide'));
            var tabs = Array.prototype.slice.call(root.querySelectorAll('.adm-tab'));
            var prev = root.querySelector('[data-adm-prev]');
            var next = root.querySelector('[data-adm-next]');
            var pos = root.querySelector('[data-adm-pos]');
            if (!slides.length) { return; }
            var current = 0;

            function indexOfKey(key) {
                for (var j = 0; j < slides.length; j++) {
                    if (slides[j].getAttribute('data-slide') === key) { return j; }
                }
                return -1;
            }

            function show(n) {
                current = Math.max(0, Math.min(n, slides.length - 1));
                slides.forEach(function (s, idx) { s.classList.toggle('is-active', idx === current); });
                tabs.forEach(function (t, idx) { t.classList.toggle('is-active', idx === current); });
                if (pos) { pos.textContent = (current + 1) + ' / ' + slides.length; }
                if (prev) { prev.disabled = current === 0; }
                if (next) { next.disabled = current === slides.length - 1; }
                try { sessionStorage.setItem(storeKey, slides[current].getAttribute('data-slide')); } catch (e) {}
            }

            tabs.forEach(function (t, idx) {
                t.addEventListener('click', function () { show(idx); root.scrollIntoView({ block: 'nearest' }); });
            });
            if (prev) { prev.addEventListener('click', function () { show(current - 1); root.scrollIntoView({ block: 'nearest' }); }); }
            if (next) { next.addEventListener('click', function () { show(current + 1); root.scrollIntoView({ block: 'nearest' }); }); }

            var saved = -1;
            try { saved = indexOfKey(sessionStorage.getItem(storeKey)); } catch (e) {}
            show(saved >= 0 ? saved : 0);
        }());
    </script>
{% endblock %}
