{% extends 'app_base.html.twig' %}

{% block title %}Postulantes · {{ parent() }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="/assets/gestion/css/gestion.css?v=17">
{% endblock %}

{% block javascripts %}
    <script src="/assets/gestion/js/gestion-filters.js?v=9" defer></script>
    <script src="/assets/gestion/js/gestion-bulk-actions.js?v=9" defer></script>
{% endblock %}

{% set estadoClass = {'VALIDADA':'activa','CONFIRMADA':'activa','RECHAZADA':'inactiva','ANULADA':'inactiva','PRESENTADA':'borrador','BORRADOR':'borrador','PENDIENTE':'borrador','COMPLETADA':'activa'} %}

{% block app_content %}
    <div class="gestion-head">
        <div>
            <p class="gestion-eyebrow">CUP FICCT · Admisiones</p>
            <h1 class="app-content__title">Postulaciones</h1>
            {% if gestion %}
                <p class="gestion-help" style="margin:4px 0 0">Gestion: <strong>{{ gestion.codigo }}</strong></p>
            {% endif %}
            <p style="margin:10px 0 0"><a class="gestion-button" href="{{ path('inscripcion_admin_calendario') }}{{ gestion ? '?gestion=' ~ gestion.id : '' }}">Calendario de revision</a></p>
        </div>
        {% if gestiones is defined and gestiones|length > 0 %}
            <form method="get" action="{{ path('inscripcion_admin') }}" class="gestion-head__actions">
                <label class="gestion-bulk-actions__select">
                    Gestion
                    <select name="gestion" onchange="this.form.submit()">
                        {% for g in gestiones %}
                            <option value="{{ g.id }}" {{ gestion and gestion.id == g.id ? 'selected' : '' }}>{{ g.codigo }}{{ g.isActive ? ' (activa)' : '' }}</option>
                        {% endfor %}
                    </select>
                </label>
                <noscript><button class="gestion-button" type="submit">Ver</button></noscript>
            </form>
        {% endif %}
    </div>

    {% include '@gestion/partials/_flash.html.twig' %}

    {% if gestion is null %}
        <section class="gestion-panel">
            <p class="gestion-panel__hint">No hay ninguna gestion seleccionada o activa. Crea o activa una gestion para gestionar postulaciones.</p>
        </section>
    {% else %}
    <section class="gestion-panel" data-bulk-root>
        {# ---- Pestañas: bandeja / aprobados por tipo ---- #}
        <div class="gestion-tabs" role="tablist">
            <button type="button" class="gestion-tab is-active" data-admision-tab data-tab-tipo="" data-tab-aprobado="">Bandeja general</button>
            <button type="button" class="gestion-tab" data-admision-tab data-tab-tipo="ESTUDIANTE" data-tab-aprobado="1">Estudiantes aprobados</button>
            <button type="button" class="gestion-tab" data-admision-tab data-tab-tipo="DOCENTE" data-tab-aprobado="1">Docentes aprobados</button>
        </div>

        <form class="gestion-filters" data-gestion-filters data-filter-target="postulaciones">
            <div class="gestion-filters__field">
                <label>Buscar</label>
                <input type="search" data-filter-field="texto" placeholder="CI, nombre o email">
            </div>
            <div class="gestion-filters__field">
                <label>Tipo</label>
                <select data-filter-field="tipo">
                    <option value="">Todos</option>
                    <option value="ESTUDIANTE">Estudiante</option>
                    <option value="DOCENTE">Docente</option>
                </select>
            </div>
            <div class="gestion-filters__field">
                <label>Estado</label>
                <select data-filter-field="estado">
                    <option value="">Todos</option>
                    <option value="BORRADOR">Borrador</option>
                    <option value="PRESENTADA">Presentada</option>
                    <option value="VALIDADA">Validada</option>
                    <option value="CONFIRMADA">Confirmada</option>
                    <option value="RECHAZADA">Rechazada</option>
                    <option value="ANULADA">Anulada</option>
                </select>
            </div>
            <input type="hidden" data-filter-field="aprobado" value="">
            <div class="gestion-filters__field gestion-filters__field--clear">
                <label aria-hidden="true">Limpiar</label>
                <button class="gestion-filters__clear" type="button" data-filter-clear aria-label="Limpiar filtros">
                    <svg viewBox="0 0 24 24"><path d="M3 6h18"/><path d="M8 6V4h8v2"/><path d="m6 10 1 10h10l1-10"/><path d="M10 14v3"/><path d="M14 14v3"/></svg>
                </button>
            </div>
        </form>

        {# ---- Barra de acciones masivas (aparece al seleccionar) ---- #}
        <form id="admision-bulk-form" method="post" class="gestion-bulk-actions" data-bulk-actions hidden>
            <input type="hidden" name="_csrf_token" value="{{ csrf_token|default('') }}">
            <input type="hidden" name="gestion" value="{{ gestion.id }}">
            <div class="gestion-bulk-actions__info">
                <span class="gestion-bulk-actions__count"><strong data-bulk-count>0</strong> postulaciones seleccionadas</span>
                <button type="button" class="gestion-bulk-actions__clear" data-bulk-clear>Deseleccionar</button>
            </div>
            <div class="gestion-bulk-actions__buttons">
                <label class="gestion-bulk-actions__select">
                    Motivo (rechazo)
                    <input type="text" name="motivo" placeholder="Opcional">
                </label>
                <button type="submit" class="gestion-button gestion-button--primary" formaction="{{ path('inscripcion_admin_validar_bulk') }}" data-bulk-submit disabled
                        data-confirm="Aprobar las postulaciones seleccionadas? Solo se aprueban las que tienen todos sus documentos aprobados.">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
                    Aprobar
                </button>
                <button type="submit" class="gestion-button gestion-button--danger" formaction="{{ path('inscripcion_admin_rechazar_bulk') }}" data-bulk-submit disabled
                        data-confirm="Rechazar las postulaciones seleccionadas?">
                    Rechazar
                </button>
            </div>
        </form>

        <div class="gestion-table-wrap">
            <table class="gestion-table gestion-table--stack" data-gestion-filter-table="postulaciones">
                <thead>
                    <tr>
                        <th><input class="gestion-bulk-check" type="checkbox" data-bulk-check-all aria-label="Seleccionar postulaciones visibles"></th>
                        <th>CI</th>
                        <th>Postulante</th>
                        <th>Tipo</th>
                        <th>Carrera / Area</th>
                        <th class="gestion-col--center">Estado</th>
                        <th class="gestion-col--center">Acta</th>
                        <th class="gestion-table__actions-cell">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    {% for inscripcion in inscripciones %}
                        {% set acta = inscripcion.resumenActa %}
                        <tr data-filter-row
                            data-filter-texto="{{ inscripcion.ci }} {{ inscripcion.nombres }} {{ inscripcion.apellidos }} {{ inscripcion.email }}"
                            data-filter-tipo="{{ inscripcion.tipo }}"
                            data-filter-estado="{{ inscripcion.estado }}"
                            data-filter-aprobado="{{ inscripcion.estado in ['VALIDADA','CONFIRMADA'] ? '1' : '0' }}">
                            <td data-label="Seleccion">
                                <input class="gestion-bulk-check" type="checkbox" name="inscripciones[]" value="{{ inscripcion.id }}" form="admision-bulk-form" data-bulk-item aria-label="Seleccionar {{ inscripcion.ci }}">
                            </td>
                            <td data-label="CI">{{ inscripcion.ci }}</td>
                            <td class="gestion-col--text" data-label="Postulante">{{ inscripcion.apellidos }} {{ inscripcion.nombres }}</td>
                            <td data-label="Tipo">{{ inscripcion.tipo == 'DOCENTE' ? 'Docente' : 'Estudiante' }}</td>
                            <td class="gestion-col--text" data-label="Carrera / Area">
                                {{ inscripcion.tipo == 'DOCENTE' ? (inscripcion.docenteProfesion ?? '—') : (inscripcion.carrera ? inscripcion.carrera.nombre : '—') }}
                            </td>
                            <td class="gestion-col--center" data-label="Estado">
                                <span class="gestion-badge gestion-badge--{{ estadoClass[inscripcion.estado] ?? 'borrador' }}">{{ inscripcion.estado|lower|capitalize }}</span>
                                {% if inscripcion.anulacionSolicitada %}
                                    <span class="gestion-badge gestion-badge--inactiva" title="El postulante solicito anular">Anulacion solicitada</span>
                                {% endif %}
                            </td>
                            <td class="gestion-col--center" data-label="Acta">
                                {% if inscripcion.estado in ['PRESENTADA','VALIDADA','CONFIRMADA'] %}
                                    <span class="gestion-badge gestion-badge--{{ acta.conformes == acta.obligatorios ? 'activa' : (acta.observados > 0 ? 'inactiva' : 'borrador') }}" title="Requisitos obligatorios conformes">{{ acta.conformes }}/{{ acta.obligatorios }}</span>
                                {% else %}
                                    <span class="gestion-table__meta">—</span>
                                {% endif %}
                            </td>
                            <td data-label="Acciones" class="gestion-table__actions">
                                <a class="gestion-action-button gestion-action-button--view" href="{{ path('inscripcion_admin_detalle', {id: inscripcion.id}) }}" title="Ver / revisar">
                                    <svg viewBox="0 0 24 24"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                                </a>
                                <a class="gestion-action-button gestion-action-button--edit" href="{{ path('inscripcion_edit', {id: inscripcion.id}) }}" title="Editar">
                                    <svg viewBox="0 0 24 24"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                                </a>
                            </td>
                        </tr>
                    {% endfor %}
                    <tr data-filter-empty {{ inscripciones ? 'hidden' : '' }}>
                        <td colspan="8">No hay postulaciones que coincidan.</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </section>

    <script>
        (function () {
            var tabs = Array.prototype.slice.call(document.querySelectorAll('[data-admision-tab]'));
            var form = document.querySelector('[data-gestion-filters]');
            if (!form) { return; }
            var tipo = form.querySelector('[data-filter-field="tipo"]');
            var aprobado = form.querySelector('[data-filter-field="aprobado"]');
            var estado = form.querySelector('[data-filter-field="estado"]');

            function syncHighlight() {
                var t = tipo ? tipo.value : '';
                var a = aprobado ? aprobado.value : '';
                tabs.forEach(function (tab) {
                    var match = (tab.getAttribute('data-tab-tipo') || '') === t
                        && (tab.getAttribute('data-tab-aprobado') || '') === a;
                    tab.classList.toggle('is-active', match);
                });
            }

            tabs.forEach(function (tab) {
                tab.addEventListener('click', function () {
                    if (tipo) { tipo.value = tab.getAttribute('data-tab-tipo') || ''; }
                    if (aprobado) { aprobado.value = tab.getAttribute('data-tab-aprobado') || ''; }
                    if (estado) { estado.value = ''; }
                    form.dispatchEvent(new Event('change', { bubbles: true }));
                    syncHighlight();
                });
            });

            // Mantener el resaltado en sincronia con cambios manuales o con "Limpiar".
            form.addEventListener('change', function () { window.setTimeout(syncHighlight, 0); });
            form.addEventListener('input', function () { window.setTimeout(syncHighlight, 0); });
            var clearBtn = form.querySelector('[data-filter-clear]');
            if (clearBtn) { clearBtn.addEventListener('click', function () { window.setTimeout(syncHighlight, 0); }); }
            syncHighlight();
        }());
    </script>
    {% endif %}
{% endblock %}
