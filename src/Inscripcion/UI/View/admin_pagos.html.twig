{% extends 'app_base.html.twig' %}

{% block title %}Pagos · {{ parent() }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="/assets/gestion/css/gestion.css?v=17">
{% endblock %}

{% set estadoBadge = {'PAGADO':'activa','PENDIENTE':'borrador','CANCELADO':'inactiva','FALLIDO':'inactiva','EXPIRADO':'inactiva'} %}

{% block app_content %}
    <div class="gestion-head">
        <div>
            <p class="gestion-eyebrow">CUP FICCT · Administracion academica</p>
            <h1 class="app-content__title">Pagos de inscripcion</h1>
            {% if gestion %}
                <p class="gestion-help" style="margin:4px 0 0">Gestion: <strong>{{ gestion.codigo }}</strong></p>
            {% endif %}
        </div>
        {% if gestiones is defined and gestiones|length > 0 %}
            <form method="get" action="{{ path('inscripcion_admin_pagos') }}" class="gestion-head__actions">
                <label class="gestion-bulk-actions__select">
                    Gestion
                    <select name="gestion" onchange="this.form.submit()">
                        {% for g in gestiones %}
                            <option value="{{ g.id }}" {{ gestion and gestion.id == g.id ? 'selected' : '' }}>{{ g.codigo }}{{ g.isActive ? ' (activa)' : '' }}</option>
                        {% endfor %}
                    </select>
                </label>
                <label class="gestion-bulk-actions__select">
                    Estado
                    <select name="estado" onchange="this.form.submit()">
                        <option value="">Todos</option>
                        {% for e in estados %}
                            <option value="{{ e }}" {{ estadoSeleccionado == e ? 'selected' : '' }}>{{ e|capitalize }}</option>
                        {% endfor %}
                    </select>
                </label>
                <noscript><button class="gestion-button" type="submit">Ver</button></noscript>
            </form>
        {% endif %}
    </div>

    {% include '@gestion/partials/_flash.html.twig' %}

    {% if not pasarelaConfigurada %}
        <section class="gestion-panel">
            <p class="gestion-panel__hint" style="color:#9b1c1c">
                La pasarela de pago no esta configurada (falta <code>STRIPE_SECRET_KEY</code>). Los postulantes no podran pagar hasta definir las claves de Stripe.
            </p>
        </section>
    {% endif %}

    {% if gestion is null %}
        <section class="gestion-panel">
            <p class="gestion-panel__hint">No hay ninguna gestion seleccionada o activa.</p>
        </section>
    {% else %}
        <section class="gestion-panel">
            <div class="gestion-table-wrap">
                <table class="gestion-table gestion-table--stack">
                    <tbody>
                        <tr>
                            <td class="gestion-col--text" data-label="Recaudado"><strong>Recaudado:</strong> {{ (resumen.recaudado / 100)|number_format(2, '.', ',') }}</td>
                            <td class="gestion-col--center" data-label="Pagados"><strong>Pagados:</strong> {{ resumen.pagados }}</td>
                            <td class="gestion-col--center" data-label="Pendientes"><strong>Pendientes:</strong> {{ resumen.pendientes }}</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </section>

        <section class="gestion-panel">
            <div class="gestion-table-wrap">
                <table class="gestion-table gestion-table--stack">
                    <thead>
                        <tr>
                            <th>Postulante</th>
                            <th>CI</th>
                            <th class="gestion-col--center">Monto</th>
                            <th class="gestion-col--center">Estado</th>
                            <th>Fecha</th>
                            <th>Referencia Stripe</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for pago in pagos %}
                            <tr>
                                <td class="gestion-col--text" data-label="Postulante">{{ pago.inscripcion.apellidos }} {{ pago.inscripcion.nombres }}<span class="gestion-table__meta">{{ pago.email }}</span></td>
                                <td data-label="CI">{{ pago.inscripcion.ci }}</td>
                                <td class="gestion-col--center" data-label="Monto">{{ pago.montoDecimal|number_format(2, '.', ',') }} {{ pago.currency }}</td>
                                <td class="gestion-col--center" data-label="Estado"><span class="gestion-badge gestion-badge--{{ estadoBadge[pago.estado] ?? 'borrador' }}">{{ pago.estado|capitalize }}</span></td>
                                <td data-label="Fecha">{{ (pago.paidAt ?? pago.createdAt)|date('d/m/Y H:i') }}</td>
                                <td class="gestion-col--text" data-label="Referencia Stripe"><span class="gestion-table__meta">{{ pago.stripePaymentIntentId ?? pago.stripeSessionId ?? '—' }}</span></td>
                            </tr>
                        {% else %}
                            <tr><td colspan="6">No hay pagos registrados para esta gestion.</td></tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </section>
    {% endif %}
{% endblock %}
