{% extends 'base.html.twig' %}

{% block title %}Crear cuenta - ExamenParcial-2{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="/assets/auth/css/auth.css">
{% endblock %}

{% block body %}
    <section class="auth-card">
        <h1 class="auth-card__title">Crear cuenta</h1>
        <p class="auth-card__subtitle">Es rapido y facil.</p>

        {% for message in app.flashes('error') %}
            <div class="alert alert--error" role="alert">{{ message }}</div>
        {% endfor %}

        <form method="post" action="{{ path('auth_register') }}" data-auth-form novalidate>
            <input type="hidden" name="_csrf_token" value="{{ csrf_token }}">

            <div class="auth-form__row">
                <div class="auth-form__field">
                    <label class="auth-form__label" for="register-first-name">Nombre</label>
                    <input id="register-first-name" class="auth-form__input" type="text" name="firstName" autocomplete="given-name" required>
                </div>

                <div class="auth-form__field">
                    <label class="auth-form__label" for="register-last-name">Apellido</label>
                    <input id="register-last-name" class="auth-form__input" type="text" name="lastName" autocomplete="family-name" required>
                </div>
            </div>

            <div class="auth-form__field">
                <label class="auth-form__label" for="register-email">Correo electronico</label>
                <input id="register-email" class="auth-form__input" type="email" name="email" autocomplete="email" required>
            </div>

            <div class="auth-form__field">
                <label class="auth-form__label" for="register-password">Contrasena</label>
                <div class="auth-password-field">
                    <input
                        id="register-password"
                        class="auth-form__input auth-password-field__input"
                        type="password"
                        name="password"
                        autocomplete="new-password"
                        required
                        data-strong-password
                    >
                    <button class="auth-password-field__toggle" type="button" data-password-toggle aria-label="Mostrar contrasena" title="Mostrar contrasena">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z"/><circle cx="12" cy="12" r="3"/></svg>
                    </button>
                </div>
                <p class="auth-form__hint">Minimo 8 caracteres, mayuscula, minuscula, numero y simbolo.</p>
            </div>

            <button type="submit" class="auth-form__submit">Registrarme</button>
        </form>

        <p class="auth-form__footer">
            Ya tienes cuenta? <a href="{{ path('auth_login') }}">Iniciar sesion</a>
        </p>
    </section>
{% endblock %}

{% block javascripts %}
    <script src="/assets/auth/js/auth.js?v=2" defer></script>
{% endblock %}
