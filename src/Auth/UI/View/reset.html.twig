{% extends 'base.html.twig' %}

{% block title %}Nueva contrasena - ExamenParcial-2{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="/assets/auth/css/auth.css">
{% endblock %}

{% block body %}
    <section class="auth-card">
        <h1 class="auth-card__title">Nueva contrasena</h1>
        <p class="auth-card__subtitle">Elige una contrasena nueva para tu cuenta. No puede ser igual a la anterior.</p>

        {% for message in app.flashes('error') %}
            <div class="alert alert--error" role="alert">{{ message }}</div>
        {% endfor %}

        <form method="post" action="{{ path('auth_reset', {'token': token}) }}" data-auth-form novalidate>
            <input type="hidden" name="_csrf_token" value="{{ csrf_token }}">

            <div class="auth-form__field">
                <label class="auth-form__label" for="reset-password">Nueva contrasena</label>
                <div class="auth-password-field">
                    <input
                        id="reset-password"
                        class="auth-form__input auth-password-field__input"
                        type="password"
                        name="password"
                        autocomplete="new-password"
                        required
                        data-strong-password
                    >
                    <button class="auth-password-field__toggle" type="button" data-password-toggle aria-label="Mostrar contrasena" title="Mostrar contrasena">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z"/><circle cx="12" cy="12" r="3"/></svg>
                    </button>
                </div>
                <p class="auth-form__hint">Minimo 8 caracteres, mayuscula, minuscula, numero y simbolo.</p>
            </div>

            <div class="auth-form__field">
                <label class="auth-form__label" for="reset-password-confirmation">Repite la contrasena</label>
                <div class="auth-password-field">
                    <input
                        id="reset-password-confirmation"
                        class="auth-form__input auth-password-field__input"
                        type="password"
                        name="passwordConfirmation"
                        autocomplete="new-password"
                        required
                    >
                    <button class="auth-password-field__toggle" type="button" data-password-toggle aria-label="Mostrar contrasena" title="Mostrar contrasena">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z"/><circle cx="12" cy="12" r="3"/></svg>
                    </button>
                </div>
            </div>

            <button type="submit" class="auth-form__submit">Cambiar contrasena</button>
        </form>

        <p class="auth-form__footer">
            <a href="{{ path('auth_login') }}">Volver al inicio de sesion</a>
        </p>
    </section>
{% endblock %}

{% block javascripts %}
    <script src="/assets/auth/js/auth.js?v=2" defer></script>
{% endblock %}
