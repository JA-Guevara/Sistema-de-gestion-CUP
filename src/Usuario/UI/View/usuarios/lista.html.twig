{% extends 'app_base.html.twig' %}

{% block title %}Usuarios{% endblock %}

{% block stylesheets %}<link rel="stylesheet" href="/assets/gestion/css/gestion.css?v=17">{% endblock %}
{% block javascripts %}<script src="/assets/gestion/js/gestion-filters.js?v=9" defer></script>{% endblock %}

{% block app_content %}
    <section class="gestion-head">
        <div>
            <p class="gestion-eyebrow">Administracion</p>
            <h1 class="app-content__title">Usuarios</h1>
        </div>
        <div class="gestion-head__actions">
            <a href="{{ path('rol_index') }}" class="gestion-button">Roles y permisos</a>
            <a href="{{ path('usuario_new') }}" class="gestion-button gestion-button--primary">Nuevo usuario</a>
        </div>
    </section>

    {% include '@gestion/partials/_flash.html.twig' %}

    <section class="gestion-panel">
        <div class="gestion-panel__header">
            <div>
                <h2>Historial de usuarios</h2>
                <p class="gestion-panel__hint">Gestiona accesos, estado operativo y roles asignados a cada cuenta.</p>
            </div>
        </div>
        <form class="gestion-filters" data-gestion-filters data-filter-target="usuarios">
            <div class="gestion-filters__field">
                <label>Buscar</label>
                <input data-filter-field="texto" placeholder="Nombre, apellido o correo">
            </div>
            <div class="gestion-filters__field">
                <label>Rol</label>
                <select data-filter-field="rol">
                    <option value="">Todos</option>
                    {% for rol in roles %}
                        <option value="{{ rol.name }}">{{ rol.name }}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="gestion-filters__field">
                <label>Estado</label>
                <select data-filter-field="estado">
                    <option value="">Todos</option>
                    <option value="ACTIVO">Activo</option>
                    <option value="INACTIVO">Inactivo</option>
                </select>
            </div>
            <div class="gestion-filters__field gestion-filters__field--clear">
                <label aria-hidden="true">Limpiar</label>
                <button class="gestion-filters__clear" type="button" data-filter-clear aria-label="Limpiar filtros">
                    <svg viewBox="0 0 24 24"><path d="M3 6h18"/><path d="M8 6V4h8v2"/><path d="m6 10 1 10h10l1-10"/><path d="M10 14v3"/><path d="M14 14v3"/></svg>
                </button>
            </div>
        </form>
        <div class="gestion-table-wrap">
            <table class="gestion-table gestion-table--stack" data-gestion-filter-table="usuarios">
                <thead>
                    <tr>
                        <th>Usuario</th>
                        <th>Correo</th>
                        <th>Roles</th>
                        <th class="gestion-col--center">Estado</th>
                        <th>Ultimo acceso</th>
                        <th class="gestion-table__actions-cell">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    {% for usuario in usuarios %}
                        {% set estado = usuario.active ? 'ACTIVO' : 'INACTIVO' %}
                        <tr data-filter-row data-filter-texto="{{ usuario.firstName }} {{ usuario.lastName }} {{ usuario.email }}" data-filter-rol="{{ usuario.roleNames() }}" data-filter-estado="{{ estado }}">
                            <td data-label="Usuario">
                                {{ usuario.firstName }} {{ usuario.lastName }}
                                <span class="gestion-table__meta">#{{ usuario.id }}</span>
                            </td>
                            <td data-label="Correo">{{ usuario.email }}</td>
                            <td data-label="Roles">{{ usuario.roleNames() }}</td>
                            <td class="gestion-col--center" data-label="Estado"><span class="gestion-badge gestion-badge--{{ usuario.active ? 'activa' : 'inactiva' }}">{{ usuario.active ? 'Activo' : 'Inactivo' }}</span></td>
                            <td data-label="Ultimo acceso">{{ usuario.lastLoginAt ? usuario.lastLoginAt|date('Y-m-d H:i') : 'Sin acceso' }}</td>
                            <td class="gestion-table__actions-cell" data-label="Acciones">
                                <div class="gestion-table__actions">
                                    <a class="gestion-action-button gestion-action-button--view" href="{{ path('usuario_show', {id: usuario.id}) }}" aria-label="Ver usuario" title="Ver">
                                        <svg viewBox="0 0 24 24"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z"/><circle cx="12" cy="12" r="3"/></svg>
                                    </a>
                                    <a class="gestion-action-button gestion-action-button--edit" href="{{ path('usuario_edit', {id: usuario.id}) }}" aria-label="Editar usuario" title="Editar">
                                        <svg viewBox="0 0 24 24"><path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>
                                    </a>
                                    <form method="post" action="{{ path('usuario_toggle', {id: usuario.id}) }}">
                                        <button class="gestion-link-button {{ usuario.active ? 'gestion-link-button--danger' : 'gestion-link-button--toggle' }}" type="submit" aria-label="{{ usuario.active ? 'Desactivar usuario' : 'Activar usuario' }}" title="{{ usuario.active ? 'Desactivar' : 'Activar' }}">
                                            {% if usuario.active %}
                                                <svg viewBox="0 0 24 24"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
                                            {% else %}
                                                <svg viewBox="0 0 24 24"><path d="M20 6 9 17l-5-5"/></svg>
                                            {% endif %}
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                    <tr data-filter-empty {{ usuarios ? 'hidden' : '' }}><td colspan="6">Todavia no hay usuarios registrados.</td></tr>
                </tbody>
            </table>
        </div>
    </section>
{% endblock %}
