{% extends 'app_base.html.twig' %}

{% block title %}{{ usuario ? 'Editar usuario' : 'Nuevo usuario' }}{% endblock %}

{% block stylesheets %}<link rel="stylesheet" href="/assets/gestion/css/gestion.css?v=17">{% endblock %}
{% block javascripts %}<script src="/assets/auth/js/auth.js?v=2" defer></script>{% endblock %}

{% block app_content %}
    {% set selectedRoleIds = usuario ? usuario.roles|map(rol => rol.id) : [] %}
    <section class="gestion-head">
        <div>
            <p class="gestion-eyebrow">Administracion</p>
            <h1 class="app-content__title">{{ usuario ? 'Editar usuario' : 'Nuevo usuario' }}</h1>
        </div>
        <a href="{{ usuario ? path('usuario_show', {id: usuario.id}) : path('usuario_index') }}" class="gestion-button">Volver</a>
    </section>

    {% include '@gestion/partials/_flash.html.twig' %}

    <form method="post" class="gestion-form" data-auth-form novalidate>
        <section class="gestion-panel">
            <h2>Datos de acceso</h2>
            <div class="gestion-grid">
                <label>
                    Nombre
                    <input name="firstName" value="{{ usuario ? usuario.firstName : '' }}" placeholder="Nombre" required>
                </label>
                <label>
                    Apellido
                    <input name="lastName" value="{{ usuario ? usuario.lastName : '' }}" placeholder="Apellido" required>
                </label>
                <label>
                    Correo electronico
                    <input type="email" name="email" value="{{ usuario ? usuario.email : '' }}" placeholder="usuario@cup.local" required>
                </label>
                <label>
                    Contrasena {{ usuario ? '(opcional)' : '' }}
                    <div class="gestion-password-field auth-password-field">
                        <input class="auth-password-field__input" type="password" name="password" autocomplete="new-password" {{ usuario ? '' : 'required' }} data-strong-password>
                        <button class="auth-password-field__toggle" type="button" data-password-toggle aria-label="Mostrar contrasena" title="Mostrar contrasena">
                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z"/><circle cx="12" cy="12" r="3"/></svg>
                        </button>
                    </div>
                </label>
            </div>
            <p class="gestion-help">Minimo 8 caracteres, mayuscula, minuscula, numero y simbolo. Al editar, deja la contrasena vacia si no quieres cambiarla.</p>
            <div class="gestion-checks">
                <label>
                    <input type="checkbox" name="active" value="1" {{ usuario is null or usuario.active ? 'checked' : '' }}>
                    <span>Usuario activo</span>
                </label>
            </div>
        </section>

        <section class="gestion-panel">
            <h2>Roles asignados</h2>
            <div class="gestion-checks gestion-checks--cards">
                {% for rol in roles %}
                    <label>
                        <input type="checkbox" name="roles[]" value="{{ rol.id }}" {{ rol.id in selectedRoleIds ? 'checked' : '' }}>
                        <span>{{ rol.name }}{% if not rol.active %} (inactivo){% endif %}</span>
                    </label>
                {% else %}
                    <p class="gestion-help">Todavia no hay roles creados. Crea primero un rol para asignarlo al usuario.</p>
                {% endfor %}
            </div>
        </section>

        <div class="gestion-actions">
            <button class="gestion-button gestion-button--primary" type="submit">Guardar usuario</button>
            <a href="{{ usuario ? path('usuario_show', {id: usuario.id}) : path('usuario_index') }}" class="gestion-button">Cancelar</a>
        </div>
    </form>
{% endblock %}
