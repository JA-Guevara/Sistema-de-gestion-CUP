{% extends 'app_base.html.twig' %}

{% block title %}Roles y permisos{% endblock %}

{% block stylesheets %}<link rel="stylesheet" href="/assets/gestion/css/gestion.css?v=17">{% endblock %}
{% block javascripts %}<script src="/assets/gestion/js/gestion-filters.js?v=9" defer></script>{% endblock %}

{% block app_content %}
    <section class="gestion-head">
        <div>
            <p class="gestion-eyebrow">Administracion</p>
            <h1 class="app-content__title">Roles y permisos</h1>
        </div>
        <div class="gestion-head__actions">
            <a href="{{ path('usuario_index') }}" class="gestion-button">Usuarios</a>
            <a href="{{ path('rol_new') }}" class="gestion-button gestion-button--primary">Nuevo rol</a>
        </div>
    </section>

    {% include '@gestion/partials/_flash.html.twig' %}

    <section class="gestion-panel">
        <div class="gestion-panel__header">
            <div>
                <h2>Historial de roles</h2>
                <p class="gestion-panel__hint">Define que puede ver, crear, editar o desactivar cada tipo de usuario.</p>
            </div>
        </div>
        <form class="gestion-filters" data-gestion-filters data-filter-target="roles">
            <div class="gestion-filters__field">
                <label>Buscar</label>
                <input data-filter-field="texto" placeholder="Nombre o descripcion">
            </div>
            <div class="gestion-filters__field">
                <label>Estado</label>
                <select data-filter-field="estado">
                    <option value="">Todos</option>
                    <option value="ACTIVO">Activo</option>
                    <option value="INACTIVO">Inactivo</option>
                </select>
            </div>
            <div class="gestion-filters__field gestion-filters__field--clear">
                <label aria-hidden="true">Limpiar</label>
                <button class="gestion-filters__clear" type="button" data-filter-clear aria-label="Limpiar filtros">
                    <svg viewBox="0 0 24 24"><path d="M3 6h18"/><path d="M8 6V4h8v2"/><path d="m6 10 1 10h10l1-10"/><path d="M10 14v3"/><path d="M14 14v3"/></svg>
                </button>
            </div>
        </form>
        <div class="gestion-table-wrap">
            <table class="gestion-table" data-gestion-filter-table="roles">
                <thead>
                    <tr>
                        <th>Rol</th>
                        <th>Descripcion</th>
                        <th class="gestion-col--num">Permisos</th>
                        <th class="gestion-col--center">Estado</th>
                        <th class="gestion-table__actions-cell">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    {% for rol in roles %}
                        {% set estado = rol.active ? 'ACTIVO' : 'INACTIVO' %}
                        <tr data-filter-row data-filter-texto="{{ rol.name }} {{ rol.description }}" data-filter-estado="{{ estado }}">
                            <td>{{ rol.name }}</td>
                            <td>{{ rol.description ?? '-' }}</td>
                            <td class="gestion-col--num">{{ rol.permissions|length }}</td>
                            <td class="gestion-col--center"><span class="gestion-badge gestion-badge--{{ rol.active ? 'activa' : 'inactiva' }}">{{ rol.active ? 'Activo' : 'Inactivo' }}</span></td>
                            <td class="gestion-table__actions-cell">
                                <div class="gestion-table__actions">
                                    <a class="gestion-action-button gestion-action-button--view" href="{{ path('rol_show', {id: rol.id}) }}" aria-label="Ver rol" title="Ver">
                                        <svg viewBox="0 0 24 24"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z"/><circle cx="12" cy="12" r="3"/></svg>
                                    </a>
                                    <a class="gestion-action-button gestion-action-button--edit" href="{{ path('rol_edit', {id: rol.id}) }}" aria-label="Editar rol" title="Editar">
                                        <svg viewBox="0 0 24 24"><path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>
                                    </a>
                                    <form method="post" action="{{ path('rol_toggle', {id: rol.id}) }}">
                                        <button class="gestion-link-button {{ rol.active ? 'gestion-link-button--danger' : 'gestion-link-button--toggle' }}" type="submit" aria-label="{{ rol.active ? 'Desactivar rol' : 'Activar rol' }}" title="{{ rol.active ? 'Desactivar' : 'Activar' }}">
                                            {% if rol.active %}
                                                <svg viewBox="0 0 24 24"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
                                            {% else %}
                                                <svg viewBox="0 0 24 24"><path d="M20 6 9 17l-5-5"/></svg>
                                            {% endif %}
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                    <tr data-filter-empty {{ roles ? 'hidden' : '' }}><td colspan="5">Todavia no hay roles registrados.</td></tr>
                </tbody>
            </table>
        </div>
    </section>
{% endblock %}
