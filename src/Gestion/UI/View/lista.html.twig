{% extends 'app_base.html.twig' %}

{% block title %}Gestiones CUP{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="/assets/gestion/css/gestion.css?v=17">
{% endblock %}

{% block javascripts %}<script src="/assets/gestion/js/gestion-filters.js?v=9" defer></script>{% endblock %}

{% block app_content %}
    <section class="gestion-head">
        <div>
            <p class="gestion-eyebrow">Configuracion academica</p>
            <h1 class="app-content__title">Gestiones CUP</h1>
        </div>
        <a href="{{ path('gestion_new') }}" class="gestion-button gestion-button--primary">Nueva gestion</a>
    </section>

    {% include '@gestion/partials/_flash.html.twig' %}

    <section class="gestion-dashboard">
        <article class="gestion-metric">
            <span class="gestion-metric__label">Gestion vigente</span>
            <strong>{{ dashboard.activeGestion ? dashboard.activeGestion.codigo : 'Sin gestion' }}</strong>
        </article>
        <article class="gestion-metric">
            <span class="gestion-metric__label">Cupo total</span>
            <strong>{{ dashboard.totalQuota }}</strong>
        </article>
        <article class="gestion-metric">
            <span class="gestion-metric__label">Disponibles</span>
            <strong>{{ dashboard.availableQuota }}</strong>
        </article>
        <article class="gestion-metric">
            <span class="gestion-metric__label">Carreras</span>
            <strong>{{ dashboard.enabledCareers }}</strong>
        </article>
    </section>

    <section class="gestion-panel">
        <form class="gestion-filters" data-gestion-filters data-filter-target="gestiones">
            <div class="gestion-filters__field">
                <label>Buscar</label>
                <input data-filter-field="texto" placeholder="Codigo o nombre">
            </div>
            <div class="gestion-filters__field">
                <label>Estado</label>
                <select data-filter-field="estado">
                    <option value="">Todos</option>
                    <option value="BORRADOR">Borrador</option>
                    <option value="CONFIGURACION">Configuracion</option>
                    <option value="ABIERTA_INSCRIPCION">Abierta inscripcion</option>
                    <option value="VALIDACION_DOCUMENTAL">Validacion documental</option>
                    <option value="ASIGNACION_GRUPOS">Asignacion de grupos</option>
                    <option value="EN_CLASES">En clases</option>
                    <option value="EN_EVALUACION">En evaluacion</option>
                    <option value="PUBLICACION_RESULTADOS">Publicacion de resultados</option>
                    <option value="FINALIZADA">Finalizada</option>
                    <option value="CANCELADA">Cancelada</option>
                </select>
            </div>
            <div class="gestion-filters__field">
                <label>Vigente</label>
                <select data-filter-field="vigente">
                    <option value="">Todas</option>
                    <option value="Si">Si</option>
                    <option value="No">No</option>
                </select>
            </div>
            <div class="gestion-filters__field gestion-filters__field--clear">
                <label aria-hidden="true">Limpiar</label>
                <button class="gestion-filters__clear" type="button" data-filter-clear aria-label="Limpiar filtros">
                    <svg viewBox="0 0 24 24"><path d="M3 6h18"/><path d="M8 6V4h8v2"/><path d="m6 10 1 10h10l1-10"/><path d="M10 14v3"/><path d="M14 14v3"/></svg>
                </button>
            </div>
        </form>
        <div class="gestion-table-wrap">
            <table class="gestion-table gestion-table--stack" data-gestion-filter-table="gestiones">
                <thead>
                    <tr>
                        <th>Codigo</th>
                        <th>Nombre</th>
                        <th class="gestion-col--center">Estado</th>
                        <th class="gestion-col--center">Vigente</th>
                        <th>Creada</th>
                        <th class="gestion-table__actions-cell">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    {% for gestion in gestiones %}
                        <tr data-filter-row data-filter-texto="{{ gestion.codigo }} {{ gestion.nombre }}" data-filter-estado="{{ gestion.estado }}" data-filter-vigente="{{ gestion.active ? 'Si' : 'No' }}">
                            <td data-label="Codigo">{{ gestion.codigo|gestion_label }}</td>
                            <td data-label="Nombre">{{ gestion.nombre }}</td>
                            <td class="gestion-col--center" data-label="Estado"><span class="gestion-badge gestion-badge--{{ gestion.estado|lower|replace({'_': '-'}) }}">{{ gestion.estado|replace({'_': ' '})|lower|capitalize }}</span></td>
                            <td class="gestion-col--center" data-label="Vigente"><span class="gestion-badge gestion-badge--{{ gestion.active ? 'si' : 'no' }}">{{ gestion.active ? 'Si' : 'No' }}</span></td>
                            <td data-label="Creada">{{ gestion.createdAt|date('Y-m-d') }}</td>
                            <td class="gestion-table__actions" data-label="Acciones">
                                <a class="gestion-action-button gestion-action-button--view" href="{{ path('gestion_show', {id: gestion.id}) }}" aria-label="Ver gestion" title="Ver">
                                    <svg viewBox="0 0 24 24"><path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6-10-6-10-6Z"/><circle cx="12" cy="12" r="3"/></svg>
                                </a>
                                <a class="gestion-action-button gestion-action-button--edit" href="{{ path('gestion_edit', {id: gestion.id}) }}" aria-label="Editar gestion" title="Editar">
                                    <svg viewBox="0 0 24 24"><path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>
                                </a>
                            </td>
                        </tr>
                    {% endfor %}
                    <tr data-filter-empty {{ gestiones ? 'hidden' : '' }}><td colspan="6">Todavia no hay gestiones registradas.</td></tr>
                </tbody>
            </table>
        </div>
    </section>
{% endblock %}
