{% extends 'app_base.html.twig' %}

{% block title %}Editar grupo{% endblock %}

{% block stylesheets %}<link rel="stylesheet" href="/assets/gestion/css/gestion.css?v=17">{% endblock %}

{% block app_content %}
    <section class="gestion-head">
        <div>
            <p class="gestion-eyebrow">Administracion academica</p>
            <h1 class="app-content__title">Editar grupo</h1>
        </div>
        <a href="{{ path('grupo_show', {id: grupo.id}) }}" class="gestion-button">Volver</a>
    </section>

    {% include '@gestion/partials/_flash.html.twig' %}

    <form method="post" class="gestion-form">
        <section class="gestion-panel">
            <div class="gestion-panel__header">
                <div>
                    <h2>Datos del grupo</h2>
                    <p class="gestion-panel__hint">Actualiza la gestion, codigo, cupo y estado operativo del grupo desde sus acciones de control.</p>
                </div>
            </div>
            <div class="gestion-grid gestion-grid--four">
                <label>
                    Gestion
                    <select name="gestionId" required>
                        {% for gestion in gestiones %}
                            <option value="{{ gestion.id }}" {{ grupo.gestion.id == gestion.id ? 'selected' : '' }}>{{ gestion.codigo|gestion_label }}</option>
                        {% endfor %}
                    </select>
                </label>
                <label>Codigo <input name="codigo" value="{{ grupo.codigo }}" required></label>
                <label>Nombre <input name="nombre" value="{{ grupo.nombre }}" required></label>
                <label>Cupo <input type="number" name="cupo" min="1" value="{{ grupo.cupo }}" required></label>
                <label>Inscritos estimados <input type="number" name="inscritosEstimados" min="0" value="{{ grupo.inscritosEstimados }}"></label>
                <label>
                    Turno
                    <select name="turnoId">
                        <option value="">Sin turno</option>
                        {% for turno in turnos %}
                            <option value="{{ turno.id }}" {{ grupo.turno and grupo.turno.id == turno.id ? 'selected' : '' }}>{{ turno.nombre|capitalize }}</option>
                        {% endfor %}
                    </select>
                </label>
            </div>
        </section>
        <div class="gestion-actions">
            <button class="gestion-button gestion-button--primary" type="submit">Guardar grupo</button>
            <a href="{{ path('grupo_show', {id: grupo.id}) }}" class="gestion-button">Cancelar</a>
        </div>
    </form>
{% endblock %}
