{% extends 'app_base.html.twig' %}

{% block title %}Editar horario{% endblock %}

{% block stylesheets %}<link rel="stylesheet" href="/assets/gestion/css/gestion.css?v=17">{% endblock %}

{% block app_content %}
    <section class="gestion-head">
        <div>
            <p class="gestion-eyebrow">Administracion academica</p>
            <h1 class="app-content__title">Editar horario</h1>
        </div>
        <a href="{{ path('horario_index') }}" class="gestion-button">Volver</a>
    </section>

    {% include '@gestion/partials/_flash.html.twig' %}

    <form method="post" class="gestion-form">
        <section class="gestion-panel">
            <div class="gestion-panel__header">
                <div>
                    <h2>Datos del horario</h2>
                    <p class="gestion-panel__hint">Edita una franja concreta. Para regenerar toda la semana usa el boton Crear horario del listado.</p>
                </div>
            </div>
            <div class="gestion-grid gestion-grid--three">
                <label>
                    Grupo
                    <select name="grupoId" required>
                        {% for grupo in grupos %}
                            <option value="{{ grupo.id }}" {{ horario.grupo.id == grupo.id ? 'selected' : '' }}>{{ grupo.gestion.codigo|gestion_label }} / {{ grupo.codigo }}</option>
                        {% endfor %}
                    </select>
                </label>
                <label>
                    Materia
                    <select name="materiaId" required>
                        {% for materia in materias %}
                            <option value="{{ materia.id }}" {{ horario.materia.id == materia.id ? 'selected' : '' }}>{{ materia.nombre }}</option>
                        {% endfor %}
                    </select>
                </label>
                <label>
                    Aula
                    <select name="aulaId" required>
                        {% for aula in aulas %}
                            <option value="{{ aula.id }}" {{ horario.aula.id == aula.id ? 'selected' : '' }}>{{ aula.codigo }} - Piso {{ aula.piso }}</option>
                        {% endfor %}
                    </select>
                </label>
            </div>
            <div class="gestion-grid gestion-grid--three">
                <label>
                    Dia
                    <select name="dia" required>
                        {% for dia in ['LUNES', 'MARTES', 'MIERCOLES', 'JUEVES', 'VIERNES', 'SABADO'] %}
                            <option value="{{ dia }}" {{ horario.dia == dia ? 'selected' : '' }}>{{ dia|capitalize }}</option>
                        {% endfor %}
                    </select>
                </label>
                <label>Hora inicio <input type="time" name="horaInicio" value="{{ horario.horaInicio|date('H:i') }}" required></label>
                <label>Hora fin <input type="time" name="horaFin" value="{{ horario.horaFin|date('H:i') }}" required></label>
            </div>
        </section>
        <div class="gestion-actions">
            <button class="gestion-button gestion-button--primary" type="submit">Guardar horario</button>
            <a href="{{ path('horario_index') }}" class="gestion-button">Cancelar</a>
        </div>
    </form>
{% endblock %}
