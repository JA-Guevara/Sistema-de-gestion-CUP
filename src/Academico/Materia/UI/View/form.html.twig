{% extends 'app_base.html.twig' %}

{% block title %}{{ materia ? 'Editar materia' : 'Nueva materia' }}{% endblock %}

{% block stylesheets %}<link rel="stylesheet" href="/assets/gestion/css/gestion.css">{% endblock %}

{% block app_content %}
    <section class="gestion-head">
        <div>
            <p class="gestion-eyebrow">Administracion academica</p>
            <h1 class="app-content__title">{{ materia ? 'Editar materia' : 'Nueva materia' }}</h1>
        </div>
        <a href="{{ path('materia_index') }}" class="gestion-button">Volver</a>
    </section>

    {% include '@gestion/partials/_flash.html.twig' %}

    <form method="post" class="gestion-form">
        <section class="gestion-panel">
            <h2>Datos de materia</h2>
            <div class="gestion-grid gestion-grid--three">
                <label>Codigo <input name="codigo" value="{{ materia ? materia.codigo : '' }}" placeholder="MAT" required></label>
                <label>Nombre <input name="nombre" value="{{ materia ? materia.nombre : '' }}" placeholder="Matematicas" required></label>
                <label>Area de conocimiento
                    <select name="area">
                        <option value="">Sin area</option>
                        {% for a in areas %}
                            <option value="{{ a.code }}" {{ materia and materia.area == a.code ? 'selected' : '' }}>{{ a.label }}</option>
                        {% endfor %}
                    </select>
                </label>
            </div>
            <label>Descripcion <textarea name="descripcion" rows="3">{{ materia ? materia.descripcion : '' }}</textarea></label>
        </section>
        <div class="gestion-actions">
            <button class="gestion-button gestion-button--primary" type="submit">Guardar materia</button>
            <a href="{{ path('materia_index') }}" class="gestion-button">Cancelar</a>
        </div>
    </form>
{% endblock %}
