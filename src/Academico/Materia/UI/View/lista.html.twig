{% extends 'app_base.html.twig' %}

{% block title %}Materias{% endblock %}

{% block stylesheets %}<link rel="stylesheet" href="/assets/gestion/css/gestion.css?v=17">{% endblock %}

{% block javascripts %}<script src="/assets/gestion/js/gestion-filters.js?v=9" defer></script>{% endblock %}

{% block app_content %}
    <section class="gestion-head">
        <div>
            <p class="gestion-eyebrow">Administracion academica</p>
            <h1 class="app-content__title">Materias</h1>
        </div>
        <a href="{{ path('materia_new') }}" class="gestion-button gestion-button--primary">Nueva materia</a>
    </section>

    {% include '@gestion/partials/_flash.html.twig' %}

    <section class="gestion-panel">
        <form class="gestion-filters" data-gestion-filters data-filter-target="materias">
            <div class="gestion-filters__field">
                <label>Buscar</label>
                <input data-filter-field="texto" placeholder="Codigo, nombre o descripcion">
            </div>
            <div class="gestion-filters__field">
                <label>Estado</label>
                <select data-filter-field="estado">
                    <option value="">Todos</option>
                    <option value="ACTIVA">Activa</option>
                    <option value="INACTIVA">Inactiva</option>
                </select>
            </div>
            <div class="gestion-filters__field gestion-filters__field--clear">
                <label aria-hidden="true">Limpiar</label>
                <button class="gestion-filters__clear" type="button" data-filter-clear aria-label="Limpiar filtros">
                    <svg viewBox="0 0 24 24"><path d="M3 6h18"/><path d="M8 6V4h8v2"/><path d="m6 10 1 10h10l1-10"/><path d="M10 14v3"/><path d="M14 14v3"/></svg>
                </button>
            </div>
        </form>
        <div class="gestion-table-wrap">
            <table class="gestion-table gestion-table--stack" data-gestion-filter-table="materias">
                <thead>
                    <tr>
                        <th>Codigo</th>
                        <th>Nombre</th>
                        <th>Area</th>
                        <th>Descripcion</th>
                        <th class="gestion-col--center">Estado</th>
                        <th class="gestion-table__actions-cell">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    {% for materia in materias %}
                        <tr data-filter-row data-filter-texto="{{ materia.codigo }} {{ materia.nombre }} {{ materia.descripcion }}" data-filter-estado="{{ materia.estado }}">
                            <td data-label="Codigo">{{ materia.codigo }}</td>
                            <td data-label="Nombre">{{ materia.nombre }}</td>
                            <td data-label="Area">{{ materia.area ? materia.area|capitalize : '-' }}</td>
                            <td data-label="Descripcion">{{ materia.descripcion ?? '-' }}</td>
                            <td class="gestion-col--center" data-label="Estado"><span class="gestion-badge gestion-badge--{{ materia.estado|lower }}">{{ materia.estado|lower|capitalize }}</span></td>
                            <td class="gestion-table__actions" data-label="Acciones">
                                <a class="gestion-action-button gestion-action-button--edit" href="{{ path('materia_edit', {id: materia.id}) }}" aria-label="Editar materia" title="Editar">
                                    <svg viewBox="0 0 24 24"><path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>
                                </a>
                                <form method="post" action="{{ path('materia_toggle', {id: materia.id}) }}">
                                    <button class="gestion-link-button {{ materia.active ? 'gestion-link-button--danger' : 'gestion-link-button--toggle' }}" type="submit" aria-label="{{ materia.active ? 'Desactivar materia' : 'Activar materia' }}" title="{{ materia.active ? 'Desactivar' : 'Activar' }}">
                                        {% if materia.active %}
                                            <svg viewBox="0 0 24 24"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
                                        {% else %}
                                            <svg viewBox="0 0 24 24"><path d="M20 6 9 17l-5-5"/></svg>
                                        {% endif %}
                                    </button>
                                </form>
                            </td>
                        </tr>
                    {% endfor %}
                    <tr data-filter-empty {{ materias ? 'hidden' : '' }}><td colspan="6">Todavia no hay materias registradas.</td></tr>
                </tbody>
            </table>
        </div>
    </section>
{% endblock %}
