{% extends 'app_base.html.twig' %}

{% block title %}Dashboard · Reportes{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="/assets/gestion/css/gestion.css?v=17">
    <link rel="stylesheet" href="/assets/gestion/css/reportes.css?v=7">
{% endblock %}

{% block javascripts %}
    <script src="/assets/vendor/chartjs/chart.umd.min.js?v=4.4.1" defer></script>
    <script src="/assets/gestion/js/dashboard-reportes.js?v=5" defer></script>
    <script src="/assets/gestion/js/dashboard-asistente.js?v=1" defer></script>
    <script src="/assets/vendor/sheetjs/xlsx.full.min.js?v=0.18.5" defer></script>
    <script src="/assets/gestion/js/dashboard-export.js?v=4" defer></script>
{% endblock %}

{% block app_content %}
    <div class="gestion-head">
        <div>
            <p class="gestion-eyebrow">CUP FICCT · Analítica</p>
            <h1 class="app-content__title">Dashboard &amp; Reportes</h1>
        </div>
        {% if gestiones|length > 0 %}
            <div class="rep-toolbar">
                <label class="rep-slicer">
                    <span>Gestión</span>
                    <select data-rep-gestion>
                        {% for g in gestiones %}
                            <option value="{{ g.id }}" {{ gestion and gestion.id == g.id ? 'selected' : '' }}>{{ g.codigo }}{{ g.isActive ? ' (activa)' : '' }}</option>
                        {% endfor %}
                    </select>
                </label>
            </div>
        {% endif %}
    </div>

    {% if gestion is null %}
        <section class="gestion-panel">
            <p class="gestion-panel__hint gestion-panel__block">No hay ninguna gestión activa o seleccionada. Activá o creá una gestión para ver los reportes.</p>
        </section>
    {% else %}
        {# ---- Encabezado solo visible en impresión / PDF ---- #}
        <div class="rep-print-head" aria-hidden="true">
            <h2>CUP FICCT · Dashboard &amp; Reportes</h2>
            <p>Gestión {{ gestion.codigo }}{% if filtros.carrera or filtros.materia or filtros.docente %} · con filtros aplicados{% endif %} · Generado el {{ 'now'|date('d/m/Y H:i') }}</p>
        </div>

        {# ---- Carrusel: 2 vistas ---- #}
        <div class="rep-tabs" role="tablist">
            <button type="button" class="rep-tab is-active" data-rep-tab="charts" role="tab" aria-selected="true">
                <svg viewBox="0 0 24 24"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
                Reportes
            </button>
            <button type="button" class="rep-tab" data-rep-tab="list" role="tab" aria-selected="false">
                <svg viewBox="0 0 24 24"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg>
                Detalle / Lista
            </button>
            <button type="button" class="rep-tab" data-rep-tab="docentes" role="tab" aria-selected="false">
                <svg viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                Docentes
            </button>
        </div>

        {# ============ VISTA 1: REPORTES ============ #}
        <div data-rep-panel="charts">
            <section class="rep-filters" data-rep-form="charts">
                <label class="rep-slicer">
                    <span>Carrera</span>
                    <select data-field="carrera"><option value="">Todas</option>
                        {% for c in opciones.carreras %}<option value="{{ c.id }}" {{ filtros.carrera == c.id ? 'selected' : '' }}>{{ c.nombre }}</option>{% endfor %}
                    </select>
                </label>
                <label class="rep-slicer">
                    <span>Materia</span>
                    <select data-field="materia"><option value="">Todas</option>
                        {% for m in opciones.materias %}<option value="{{ m.id }}" {{ filtros.materia == m.id ? 'selected' : '' }}>{{ m.nombre }}</option>{% endfor %}
                    </select>
                </label>
                <label class="rep-slicer">
                    <span>Docente</span>
                    <select data-field="docente"><option value="">Todos</option>
                        {% for d in opciones.docentes %}<option value="{{ d.id }}" {{ filtros.docente == d.id ? 'selected' : '' }}>{{ d.nombre }}</option>{% endfor %}
                    </select>
                </label>
                <button type="button" class="gestion-button" data-rep-clear="charts">Limpiar</button>
                <span class="rep-spacer"></span>
                <button type="button" class="gestion-button" data-rep-export="charts">Exportar CSV</button>
                <button type="button" class="gestion-button" data-rep-print>Imprimir / PDF</button>
            </section>

            <div class="rep-kpis">
                <div class="rep-kpi"><span class="rep-kpi__label">Estudiantes inscritos</span><span class="rep-kpi__value" data-kpi="inscritos">{{ payload.kpis.inscritos }}</span></div>
                <div class="rep-kpi"><span class="rep-kpi__label">Estudiantes aprobados</span><span class="rep-kpi__value rep-kpi__value--ok" data-kpi="estudiantesAprobados">{{ payload.kpis.estudiantesAprobados }}</span></div>
                <div class="rep-kpi"><span class="rep-kpi__label">Estudiantes rechazados</span><span class="rep-kpi__value rep-kpi__value--bad" data-kpi="estudiantesRechazados">{{ payload.kpis.estudiantesRechazados }}</span></div>
                <div class="rep-kpi"><span class="rep-kpi__label">Estudiantes en proceso</span><span class="rep-kpi__value rep-kpi__value--warn" data-kpi="estudiantesEnProceso">{{ payload.kpis.estudiantesEnProceso }}</span></div>
                <div class="rep-kpi"><span class="rep-kpi__label">Docentes postulados</span><span class="rep-kpi__value" data-kpi="postulacionesDocentes">{{ payload.kpis.postulacionesDocentes }}</span></div>
                <div class="rep-kpi"><span class="rep-kpi__label">Docentes aprobados</span><span class="rep-kpi__value rep-kpi__value--ok" data-kpi="docentesAprobados">{{ payload.kpis.docentesAprobados }}</span></div>
                <div class="rep-kpi"><span class="rep-kpi__label">Docentes rechazados</span><span class="rep-kpi__value rep-kpi__value--bad" data-kpi="docentesRechazados">{{ payload.kpis.docentesRechazados }}</span></div>
                <div class="rep-kpi"><span class="rep-kpi__label">Docentes en proceso</span><span class="rep-kpi__value rep-kpi__value--warn" data-kpi="docentesEnProceso">{{ payload.kpis.docentesEnProceso }}</span></div>
                <div class="rep-kpi"><span class="rep-kpi__label">Evaluados con notas</span><span class="rep-kpi__value" data-kpi="evaluados">{{ payload.kpis.evaluados }}</span></div>
                <div class="rep-kpi"><span class="rep-kpi__label">Aprobados por notas</span><span class="rep-kpi__value rep-kpi__value--ok" data-kpi="aprobados">{{ payload.kpis.aprobados }}</span></div>
                <div class="rep-kpi"><span class="rep-kpi__label">Reprobados por notas</span><span class="rep-kpi__value rep-kpi__value--bad" data-kpi="reprobados">{{ payload.kpis.reprobados }}</span></div>
                <div class="rep-kpi"><span class="rep-kpi__label">Sin notas completas</span><span class="rep-kpi__value rep-kpi__value--warn" data-kpi="incompletos">{{ payload.kpis.incompletos }}</span></div>
                <div class="rep-kpi"><span class="rep-kpi__label">% aprob. notas</span><span class="rep-kpi__value" data-kpi="pctAprobacion">{{ payload.kpis.pctAprobacion }}%</span></div>
                <div class="rep-kpi"><span class="rep-kpi__label">Promedio gral</span><span class="rep-kpi__value" data-kpi="promedioGeneral">{{ payload.kpis.promedioGeneral }}</span></div>
                <div class="rep-kpi"><span class="rep-kpi__label">Grupos habilitados</span><span class="rep-kpi__value" data-kpi="grupos">{{ payload.kpis.grupos }}</span></div>
                <div class="rep-kpi"><span class="rep-kpi__label">Docentes asignados</span><span class="rep-kpi__value" data-kpi="docentes">{{ payload.kpis.docentes }}</span></div>
            </div>

            <div class="rep-grid">
                <article class="gestion-panel rep-card"><p class="rep-card__title">Resultado academico por notas</p><div class="rep-chart"><canvas data-chart="estado"></canvas></div></article>
                <article class="gestion-panel rep-card"><p class="rep-card__title">Postulantes estudiantes por estado</p><div class="rep-chart"><canvas data-chart="postulacionesEstudiantes"></canvas></div></article>
                <article class="gestion-panel rep-card"><p class="rep-card__title">Postulantes docentes por estado</p><div class="rep-chart"><canvas data-chart="postulacionesDocentes"></canvas></div></article>
                <article class="gestion-panel rep-card"><p class="rep-card__title">Promedio por materia <small>(mín. <span data-rep-min>{{ payload.meta.notaMinima }}</span>)</small></p><div class="rep-chart"><canvas data-chart="promedioMateria"></canvas></div></article>
                <article class="gestion-panel rep-card"><p class="rep-card__title">Aprobados vs reprobados por materia</p><div class="rep-chart"><canvas data-chart="aprobMateria"></canvas></div></article>
                <article class="gestion-panel rep-card"><p class="rep-card__title">Top grupos por aprobados</p><div class="rep-chart"><canvas data-chart="topGrupos"></canvas></div></article>
                <article class="gestion-panel rep-card"><p class="rep-card__title">Inscritos por carrera</p><div class="rep-chart"><canvas data-chart="carrera"></canvas></div></article>
                <article class="gestion-panel rep-card"><p class="rep-card__title">Carga docente (grupos por docente)</p><div class="rep-chart"><canvas data-chart="docentes"></canvas></div></article>
            </div>
        </div>

        {# ============ VISTA 2: DETALLE / LISTA ============ #}
        <div data-rep-panel="list" hidden>
            <section class="rep-filters" data-rep-form="list">
                <label class="rep-slicer">
                    <span>Carrera</span>
                    <select data-field="carrera"><option value="">Todas</option>
                        {% for c in opciones.carreras %}<option value="{{ c.id }}">{{ c.nombre }}</option>{% endfor %}
                    </select>
                </label>
                <label class="rep-slicer">
                    <span>Materia</span>
                    <select data-field="materia"><option value="">Todas</option>
                        {% for m in opciones.materias %}<option value="{{ m.id }}">{{ m.nombre }}</option>{% endfor %}
                    </select>
                </label>
                <label class="rep-slicer">
                    <span>Docente</span>
                    <select data-field="docente"><option value="">Todos</option>
                        {% for d in opciones.docentes %}<option value="{{ d.id }}">{{ d.nombre }}</option>{% endfor %}
                    </select>
                </label>
                <label class="rep-slicer">
                    <span>Estado</span>
                    <select data-field="estado">
                        <option value="">Todos</option>
                        <option value="APROBADO">Aprobado</option>
                        <option value="REPROBADO">Reprobado</option>
                        <option value="INCOMPLETO">Incompleto</option>
                    </select>
                </label>
                <label class="rep-slicer rep-slicer--grow">
                    <span>Buscar</span>
                    <input type="search" data-field="texto" placeholder="CI o nombre">
                </label>
                <button type="button" class="gestion-button" data-rep-clear="list">Limpiar</button>
                <span class="rep-spacer"></span>
                <button type="button" class="gestion-button" data-rep-export="csv">Exportar CSV</button>
                <button type="button" class="gestion-button" data-rep-print>Imprimir / PDF</button>
            </section>

            <section class="gestion-panel">
                <div class="gestion-panel__header">
                    <div>
                        <h2>Detalle de postulantes</h2>
                        <p class="gestion-panel__hint">Lista filtrable y exportable, independiente de los gráficos.</p>
                    </div>
                    <span class="gestion-badge" data-rep-count>{{ payload.detalle|length }} postulantes</span>
                </div>
                <div class="gestion-table-wrap">
                    <table class="gestion-table gestion-table--stack" data-rep-table>
                        <thead>
                            <tr>
                                <th>CI</th>
                                <th>Postulante</th>
                                <th>Carrera</th>
                                <th class="gestion-col--num">Materias</th>
                                <th class="gestion-col--num">Promedio</th>
                                <th class="gestion-col--center">Estado</th>
                            </tr>
                        </thead>
                        <tbody data-rep-tbody></tbody>
                    </table>
                </div>
            </section>
        </div>

        {# ============ VISTA 3: DOCENTES ============ #}
        <div data-rep-panel="docentes" hidden>
            <section class="gestion-panel">
                <div class="gestion-panel__header">
                    <div>
                        <h2>Reporte de docentes</h2>
                        <p class="gestion-panel__hint">Carga academica (materias y grupos), asignaciones y estado de las postulaciones de docentes de la gestion.</p>
                    </div>
                </div>
                <div class="gestion-dashboard">
                    <section class="gestion-metric"><span class="gestion-metric__label">Docentes postulados</span><strong data-doc-kpi="totalPostulaciones">0</strong></section>
                    <section class="gestion-metric"><span class="gestion-metric__label">Docentes aprobados</span><strong data-doc-kpi="aprobados">0</strong></section>
                    <section class="gestion-metric"><span class="gestion-metric__label">Docentes rechazados</span><strong data-doc-kpi="rechazados">0</strong></section>
                    <section class="gestion-metric"><span class="gestion-metric__label">Docentes en proceso</span><strong data-doc-kpi="enProceso">0</strong></section>
                    <section class="gestion-metric"><span class="gestion-metric__label">Docentes con asignacion</span><strong data-doc-kpi="totalDocentes">0</strong></section>
                    <section class="gestion-metric"><span class="gestion-metric__label">Entrevistas agendadas</span><strong data-doc-kpi="entrevistasAgendadas">0</strong></section>
                </div>
                <p class="gestion-panel__hint" style="padding:0 18px"><strong>Postulaciones de docente por estado:</strong> <span data-doc-postulaciones>&mdash;</span></p>
                <div class="gestion-table-wrap">
                    <table class="gestion-table gestion-table--stack">
                        <thead>
                            <tr><th>Docente</th><th class="gestion-col--num">Materias</th><th class="gestion-col--num">Grupos</th></tr>
                        </thead>
                        <tbody data-doc-tbody></tbody>
                    </table>
                </div>
            </section>
        </div>

        {# ---- Asistente de IA (chat flotante) ---- #}
        <button type="button" class="asis-launcher" data-asis-launcher aria-label="Abrir asistente de IA" aria-expanded="false">
            <span class="asis-bot" aria-hidden="true">
                <svg viewBox="0 0 24 24">
                    <path d="M12 7V4.3"/>
                    <circle class="asis-bot__led" cx="12" cy="3" r="1.1"/>
                    <rect x="4" y="7" width="16" height="12" rx="3.5"/>
                    <circle class="asis-bot__eye" cx="9" cy="13" r="1.5"/>
                    <circle class="asis-bot__eye" cx="15" cy="13" r="1.5"/>
                    <path d="M9.5 16.4h5"/>
                </svg>
            </span>
            <span class="asis-launcher__badge" aria-hidden="true">IA</span>
        </button>
        <section class="asis-panel" data-asis-panel hidden aria-label="Asistente de reportes">
            <div class="asis-panel__head">
                <span class="asis-panel__avatar"><svg viewBox="0 0 24 24"><path d="M12 3l1.9 4.6L18.5 9 14 11l-2 5-2-5L5.5 9l4.6-1.4z"/></svg></span>
                <span class="asis-panel__title">Asistente de reportes<small>Pedímelo en palabras</small></span>
                <button type="button" class="asis-panel__close" data-asis-close aria-label="Cerrar"><svg viewBox="0 0 24 24"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg></button>
            </div>
            <div class="asis-messages" data-asis-messages>
                <div class="asis-hint">Prob&aacute;: <strong>&ldquo;promedios por materia&rdquo;</strong> · <strong>&ldquo;lista de estudiantes oficiales&rdquo;</strong> · <strong>&ldquo;solo con materias asignadas de Sistemas&rdquo;</strong> · <strong>&ldquo;postulantes rechazados&rdquo;</strong>. Toc&aacute; el micr&oacute;fono para hablar.</div>
            </div>
            <div class="asis-inputbar">
                <input type="text" data-asis-input placeholder="Escrib&iacute; o habl&aacute;&hellip;" aria-label="Tu consulta">
                <button type="button" class="asis-btn asis-btn--mic" data-asis-mic aria-label="Hablar"><svg viewBox="0 0 24 24"><path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2"/><line x1="12" y1="19" x2="12" y2="23"/></svg></button>
                <button type="button" class="asis-btn asis-btn--send" data-asis-send aria-label="Enviar"><svg viewBox="0 0 24 24"><line x1="12" y1="19" x2="12" y2="5"/><polyline points="5 12 12 5 19 12"/></svg></button>
            </div>
        </section>

        <script type="application/json" data-rep-payload>{{ payload|json_encode|raw }}</script>
        <script type="application/json" data-rep-config>{{ {'dataUrl': path('dashboard_data'), 'asistenteUrl': path('dashboard_asistente')}|json_encode|raw }}</script>
    {% endif %}
{% endblock %}
