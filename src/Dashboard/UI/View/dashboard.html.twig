{% extends 'app_base.html.twig' %}

{% block title %}Dashboard · {{ parent() }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="/assets/gestion/css/gestion.css">
{% endblock %}

{% block app_content %}
    <section class="gestion-head">
        <div>
            <p class="gestion-eyebrow">Panel administrativo</p>
            <h1 class="app-content__title">Dashboard</h1>
            {% if dashboard.gestion %}
                <p class="gestion-help" style="margin:4px 0 0">
                    Gestion: <strong>{{ dashboard.gestion.codigo }}</strong>
                    · Estado: <span class="gestion-badge {{ dashboard.gestion.estado|lower|replace({'_':'-'}) }}">{{ dashboard.gestion.estado }}</span>
                </p>
            {% else %}
                <p class="gestion-help" style="margin:4px 0 0;color:var(--ds-danger)">No hay una gestion activa.</p>
            {% endif %}
        </div>
    </section>

    <section class="gestion-dashboard">
        <article class="gestion-metric">
            <span class="gestion-metric__label">Inscripciones</span>
            <strong>{{ dashboard.totalInscritos }}</strong>
            <small style="display:block;color:var(--ds-text-muted);font-size:12px;margin-top:4px">
                {{ dashboard.cupoOcupado }}/{{ dashboard.cupoTotal }} cupos
                ({{ dashboard.porcentajeOcupacion }}%)
            </small>
        </article>
        <article class="gestion-metric">
            <span class="gestion-metric__label">Grupos habilitados</span>
            <strong>{{ dashboard.totalGrupos }}</strong>
            <small style="display:block;color:var(--ds-text-muted);font-size:12px;margin-top:4px">
                Cupo restante: {{ dashboard.cupoDisponible }}
            </small>
        </article>
        <article class="gestion-metric">
            <span class="gestion-metric__label">Carreras</span>
            <strong>{{ dashboard.carrerasHabilitadas }}</strong>
            <small style="display:block;color:var(--ds-text-muted);font-size:12px;margin-top:4px">
                habilitadas en esta gestion
            </small>
        </article>
        <article class="gestion-metric">
            <span class="gestion-metric__label">Aprobados</span>
            <strong style="color:var(--ds-success)">{{ dashboard.totalAprobados }}</strong>
            <small style="display:block;color:var(--ds-text-muted);font-size:12px;margin-top:4px">
                pendiente de modulo examenes
            </small>
        </article>
        <article class="gestion-metric">
            <span class="gestion-metric__label">Reprobados</span>
            <strong style="color:var(--ds-danger)">{{ dashboard.totalReprobados }}</strong>
            <small style="display:block;color:var(--ds-text-muted);font-size:12px;margin-top:4px">
                pendiente de modulo examenes
            </small>
        </article>
        <article class="gestion-metric">
            <span class="gestion-metric__label">Admitidos</span>
            <strong>—</strong>
            <small style="display:block;color:var(--ds-text-muted);font-size:12px;margin-top:4px">
                pendiente de admision final
            </small>
        </article>
    </section>

    {# Accesos directos #}
    <div class="gestion-head" style="margin-top:28px">
        <h2 style="font-size:18px;font-weight:700;margin:0">Accesos directos</h2>
    </div>
    <div class="app-grid">
        <a href="{{ path('inscripcion_admin') }}" class="app-card" style="text-decoration:none">
            <div class="app-card__icon">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                    <polyline points="14 2 14 8 20 8"/>
                    <line x1="16" y1="13" x2="8" y2="13"/>
                </svg>
            </div>
            <h3 class="app-card__title">Postulantes</h3>
            <p class="app-card__subtitle">Gestionar inscripciones y documentos</p>
        </a>
        <a href="{{ path('grupo_index') }}" class="app-card" style="text-decoration:none">
            <div class="app-card__icon">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/>
                    <circle cx="9" cy="7" r="4"/>
                </svg>
            </div>
            <h3 class="app-card__title">Grupos</h3>
            <p class="app-card__subtitle">Gestionar grupos del CUP</p>
        </a>
        <a href="{{ path('gestion_index') }}" class="app-card" style="text-decoration:none">
            <div class="app-card__icon">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="4" y1="21" x2="4" y2="14"/>
                    <line x1="4" y1="10" x2="4" y2="3"/>
                    <line x1="12" y1="21" x2="12" y2="12"/>
                    <line x1="12" y1="8" x2="12" y2="3"/>
                    <line x1="20" y1="21" x2="20" y2="16"/>
                    <line x1="20" y1="12" x2="20" y2="3"/>
                </svg>
            </div>
            <h3 class="app-card__title">Gestion CUP</h3>
            <p class="app-card__subtitle">Configurar gestion academica</p>
        </a>
    </div>
{% endblock %}
