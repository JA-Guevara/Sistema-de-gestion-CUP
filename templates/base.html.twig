<!doctype html>
<html lang="es">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}CUP FICCT{% endblock %}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <link rel="alternate icon" type="image/png" href="/favicon.png">
    <link rel="shortcut icon" href="/favicon.svg">

    {% block stylesheets %}{% endblock %}
</head>
<body>
    {# Sin barra superior en las vistas de autenticación: cada tarjeta trae sus
       propios enlaces. Una vista puede volver a definir este bloque si lo necesita. #}
    {% block app_chrome %}{% endblock %}

    {% block main %}
        <main class="app-main">
            {% block body %}{% endblock %}
        </main>
    {% endblock %}

    {% block javascripts %}{% endblock %}
</body>
</html>
